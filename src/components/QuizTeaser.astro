---
// Výrazná pozvánka na kvíz „Která koloběžka je pro mě?“.
import Icon from './Icon.astro';
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---
<a class:list={['qt', cls]} href="/welke-step/">
  <span class="qt__badge" aria-hidden="true">?</span>
  <span class="qt__text">
    <strong>Twijfel je welke je moet kiezen?</strong>
    <span>3 vragen, 30 seconden – en je weet of de Road, Cobra of Cross bij je past.</span>
  </span>
  <span class="qt__cta">Start de test <Icon name="arrow" size={18} /></span>
</a>

<style>
  .qt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    padding: 18px 22px;
    border-radius: var(--radius-lg);
    background: linear-gradient(120deg, #fff1e8 0%, #ffe3d1 100%);
    border: 1px solid #f6c3a8;
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .qt:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .qt__badge {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: var(--orange-500);
    color: var(--accent-ink);
    font: 800 1.7rem var(--font-display);
    transform: rotate(-6deg);
  }
  .qt__text {
    flex: 1;
    min-width: 220px;
    display: flex;
    flex-direction: column;
    color: var(--ink-soft);
  }
  .qt__text strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--forest-900);
  }
  .qt__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.7em 1.3em;
    border-radius: 999px;
    background: var(--forest-900);
    color: var(--white);
    font-weight: 650;
    white-space: nowrap;
  }
  .qt:hover .qt__cta {
    background: var(--orange-600);
  }
</style>
