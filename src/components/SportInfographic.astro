---
// Infografika: steppen vs. běh vs. kolo (orientační úrovně 1–3) a sportovní vs. městská koloběžka.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import road from '../assets/products/crussis-road-4-2-1.jpg';

// Orientační srovnání (stejné hodnoty jako dřívější tabulka); 1 = nízká, 3 = vysoká.
const cards = [
  {
    icon: 'joint', tag: 'vs. hardlopen', title: 'Vriendelijker voor je gewrichten', bg: '#dcefe5', fg: '#1d5a46',
    text: 'Geen harde klappen met je volle lichaamsgewicht. Je knieën, heupen en rug krijgen rust.',
    metric: 'Belasting gewrichten', note: 'lager is beter', levels: { steppen: 1, beh: 3, kolo: 1 },
  },
  {
    icon: 'users', tag: 'vs. fietsen', title: 'Meer spieren aan het werk', bg: '#e6eef7', fg: '#1e40af',
    text: 'Naast je benen werken ook je core, rug en armen – ze houden je rechtop en in balans.',
    metric: 'Spiergebruik', levels: { steppen: 3, beh: 2, kolo: 2 },
  },
  {
    icon: 'heart', tag: 'net als hardlopen', title: 'Volop conditie', bg: '#ffe6d9', fg: '#c2410c',
    text: 'Duurtraining voor hart en longen. Afhankelijk van je tempo verbruik je evenveel energie als bij hardlopen of fietsen.',
    metric: 'Conditietraining', levels: { steppen: 3, beh: 3, kolo: 2 },
  },
  {
    icon: 'leaf', tag: 'bonus', title: 'Balans en plezier', bg: '#f4ead6', fg: '#8a6116',
    text: 'Je traint je balans en coördinatie – met het park, het bos, de duinen en het strand als decor.',
    metric: 'Balanstraining', levels: { steppen: 3, beh: 1, kolo: 1 },
  },
] as const;
const labels = { steppen: 'Steppen', beh: 'Hardlopen', kolo: 'Fietsen' } as const;
---
<div class="info">
  <div class="vs">
    {cards.map((c) => (
      <article class="vs__card" style={`--bg:${c.bg};--fg:${c.fg}`}>
        <div class="vs__top">
          <span class="vs__icon"><Icon name={c.icon} size={24} /></span>
          <span class="vs__tag">{c.tag}</span>
        </div>
        <h3>{c.title}</h3>
        <p>{c.text}</p>
        <div class="bars" role="img" aria-label={`${c.metric}: steppen ${c.levels.steppen} van 3, hardlopen ${c.levels.beh} van 3, fietsen ${c.levels.kolo} van 3`}>
          <span class="bars__metric">{c.metric}{'note' in c && <em> · {c.note}</em>}</span>
          {(Object.keys(labels) as (keyof typeof labels)[]).map((k) => (
            <span class:list={['bar', { 'bar--hl': k === 'steppen' }]}>
              <span class="bar__label">{labels[k]}</span>
              <span class="bar__track"><span class="bar__fill" style={`width:${(c.levels[k] / 3) * 100}%`}></span></span>
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
  <p class="info__note">Indicatieve vergelijking op basis van het type belasting, geen meting. Ieder lichaam is anders – overleg bij klachten met je arts of fysiotherapeut.</p>

  <div class="duo">
    <div class="duo__head">
      <span class="eyebrow">Niet te verwarren</span>
      <h2>Sportstep ≠ stadsstep</h2>
      <p class="lead">Bij het woord step denken de meeste mensen aan een kleine opvouwbare step voor in de stad. Een sportstep is echter een heel ander apparaat.</p>
    </div>
    <div class="duo__grid">
      <article class="duo__card duo__card--city">
        <svg class="duo__city" viewBox="0 0 220 140" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="40" cy="112" r="18" />
            <circle cx="176" cy="112" r="18" />
            <path d="M40 112 H150 L176 112 M150 112 L166 24 M150 22 H184" />
          </g>
        </svg>
        <h3>Stadsstep</h3>
        <ul>
          <li>kleine wieltjes (ca. 15–20 cm)</li>
          <li>vaak opvouwbaar</li>
          <li>voor korte ritjes in de stad</li>
          <li>niet echt geschikt voor lange ritten en training</li>
        </ul>
      </article>
      <span class="duo__vs" aria-hidden="true">vs.</span>
      <article class="duo__card duo__card--sport">
        <Image src={road} alt="Sportstep Crussis Road 4.2" widths={[360, 600]} sizes="(min-width: 900px) 30vw, 80vw" class="duo__img" />
        <h3>Sportstep</h3>
        <ul>
          <li>groot voorwiel 26–28", achterwiel 20"</li>
          <li>lage treeplank – efficiënt afzetten</li>
          <li>remmen zoals op een fiets</li>
          <li>voor training, lange afstanden en terrein</li>
        </ul>
        <a href="/sportsteps/#anatomie">Bekijk hem van dichtbij →</a>
      </article>
    </div>
  </div>
</div>

<style>
  .vs {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .vs__card {
    background: var(--bg);
    border-radius: var(--radius-lg);
    padding: 22px;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease;
  }
  .vs__card:hover {
    transform: translateY(-4px);
  }
  .vs__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .vs__icon {
    width: 48px;
    height: 48px;
    border-radius: 15px;
    display: grid;
    place-items: center;
    background: var(--white);
    color: var(--fg);
    box-shadow: var(--shadow-sm);
  }
  .vs__tag {
    padding: 0.25em 0.8em;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .vs__card h3 {
    font-size: 1.25rem;
    margin-bottom: 6px;
  }
  .vs__card p {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-bottom: 16px;
  }
  .bars {
    margin-top: auto;
    display: grid;
    gap: 6px;
    padding: 12px;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.65);
  }
  .bars__metric {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--forest-900);
  }
  .bars__metric em {
    font-style: normal;
    font-weight: 500;
    color: var(--muted);
  }
  .bar {
    display: grid;
    grid-template-columns: 62px 1fr;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .bar--hl {
    color: var(--forest-900);
    font-weight: 700;
  }
  .bar__track {
    height: 8px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.07);
    overflow: hidden;
  }
  .bar__fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: #b9c4bf;
  }
  .bar--hl .bar__fill {
    background: var(--orange-500);
  }
  .info__note {
    margin: 14px 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .duo {
    margin-top: clamp(56px, 8vw, 96px);
  }
  .duo__head {
    max-width: 720px;
    margin-bottom: 28px;
  }
  .duo__grid {
    display: grid;
    gap: 16px;
    align-items: stretch;
  }
  @media (min-width: 800px) {
    .duo__grid {
      grid-template-columns: 1fr auto 1.2fr;
      align-items: center;
    }
  }
  .duo__card {
    border-radius: var(--radius-lg);
    padding: 24px;
    height: 100%;
  }
  .duo__card h3 {
    font-size: 1.35rem;
    margin: 12px 0 10px;
  }
  .duo__card ul {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 6px;
  }
  .duo__card--city {
    background: var(--white);
    border: 1px dashed var(--border);
    color: var(--muted);
  }
  .duo__card--city h3 {
    color: var(--ink-soft);
  }
  .duo__city {
    width: 46%;
    color: #b9c4bf;
  }
  .duo__card--sport {
    background: #e2f0e7;
    box-shadow: var(--shadow);
  }
  .duo__img {
    width: 80%;
    height: auto;
    mix-blend-mode: multiply;
  }
  .duo__card--sport a {
    display: inline-block;
    margin-top: 14px;
    font-weight: 650;
    color: var(--orange-600);
    text-decoration: none;
  }
  .duo__vs {
    justify-self: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--forest-900);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.1rem;
  }
</style>
