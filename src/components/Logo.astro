---
import { Image } from 'astro:assets';
import { site } from '../config';
import logo from '../assets/brand/logo-kickbike-club-hille.png';

interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
---
<a href="/" class:list={['logo', { 'logo--inverted': inverted }]} aria-label={`${site.name} – úvod`}>
  <span class="logo__badge">
    <Image src={logo} alt="" width={48} height={48} densities={[1, 2]} loading="eager" />
  </span>
  <span class="logo__text">
    <span class="logo__name">Kickbike Club</span>
    <span class="logo__place">Hille</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--forest-900);
  }
  .logo__badge {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--white);
    overflow: hidden;
  }
  .logo__badge :global(img) {
    width: 100%;
    height: 100%;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-display);
  }
  .logo__name {
    white-space: nowrap;
    font-weight: 750;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .logo__place {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--orange-600);
    margin-top: 3px;
  }
  .logo--inverted {
    color: var(--white);
  }
  .logo--inverted .logo__badge {
    width: 64px;
    height: 64px;
  }
</style>
