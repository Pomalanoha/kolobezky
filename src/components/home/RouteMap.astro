---
// Schematická ilustrovaná mapa okolí: Hoofddorp, Spaarnwoude, duny a Zandvoort.
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';

const locations = (await getCollection('locations')).sort((a, b) => a.data.order - b.data.order);
const pins: Record<string, { x: number; y: number; label: string; dx?: number }> = {
  'hoofddorp-haarlemmermeerse-bos': { x: 452, y: 318, label: 'Hoofddorp' },
  spaarnwoude: { x: 440, y: 112, label: 'Spaarnwoude' },
  'kennemerduinen-zandvoort': { x: 112, y: 214, label: 'Zandvoort', dx: -6 },
};
---
<div class="routes">
  <div class="routes__list">
    {locations.map((l, i) => (
      <a class="route" href={`/routes/${l.id}/`}>
        <span class="route__no">{i + 1}</span>
        <span class="route__body">
          <strong>{l.data.name}</strong>
          <small>{l.data.place} · {l.data.distance} · {l.data.level}</small>
        </span>
        <Icon name="arrow" size={18} />
      </a>
    ))}
  </div>

  <figure class="map">
    <svg viewBox="0 0 600 420" role="img" aria-labelledby="map-title">
      <title id="map-title">Schematická mapa tras v okolí Hoofddorpu</title>
      <!-- moře a pobřeží -->
      <path class="sea" d="M0 0 H70 C 92 90, 66 170, 88 250 S 74 360, 96 420 H0Z" />
      <path class="waves" d="M22 70 q8 -6 16 0 t16 0 M18 160 q8 -6 16 0 t16 0 M26 300 q8 -6 16 0 t16 0" />
      <!-- duny -->
      <path class="dunes" d="M88 40 C 140 60, 170 110, 160 170 S 190 300, 150 400 L 96 420 C 74 360, 92 250, 88 250 S 92 90, 70 0Z" />
      <!-- Haarlemmermeer (polder) -->
      <path class="polder" d="M300 250 C 380 220, 520 230, 570 290 S 540 410, 420 415 S 290 360, 300 250Z" />
      <!-- města (orientace) -->
      <circle class="town" cx="300" cy="172" r="7" />
      <text class="town-label" x="314" y="177">Haarlem</text>
      <text class="town-label town-label--far" x="500" y="200">Amsterdam →</text>
      <!-- trasy -->
      <path class="route-line" d="M452 318 C 400 270, 340 230, 300 172 S 200 170, 160 190 S 120 210, 112 214" />
      <path class="route-line route-line--b" d="M452 318 C 470 250, 470 170, 440 112" />
      <!-- špendlíky -->
      {locations.map((l, i) => {
        const p = pins[l.id];
        return p && (
          <a href={`/routes/${l.id}/`} aria-label={l.data.title} class="pin">
            <circle class="pin__pulse" cx={p.x} cy={p.y} r="16" />
            <circle class="pin__dot" cx={p.x} cy={p.y} r="13" />
            <text class="pin__no" x={p.x} y={p.y + 5}>{i + 1}</text>
            <text class="pin__label" x={p.x + (p.dx ?? 0) + 20} y={p.y + 5}>{p.label}</text>
          </a>
        );
      })}
      <text class="sea-label" x="18" y="400">Severní moře</text>
    </svg>
    <figcaption>Schematická mapa – trasy upřesníme na lekci.</figcaption>
  </figure>
</div>

<style>
  .routes {
    display: grid;
    gap: 28px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .routes {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
  .routes__list {
    display: grid;
    gap: 12px;
  }
  .route {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .route:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow);
  }
  .route__no {
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--orange-500);
    color: var(--accent-ink);
    font-weight: 750;
  }
  .route__body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .route__body strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--forest-900);
  }
  .route__body small {
    color: var(--muted);
  }
  .route :global(svg) {
    color: var(--orange-600);
  }

  .map {
    margin: 0;
    background: #f7f1e4;
    border-radius: var(--radius-lg);
    padding: 12px;
    box-shadow: var(--shadow-sm);
  }
  .map svg {
    width: 100%;
    height: auto;
  }
  .map figcaption {
    text-align: center;
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 4px;
  }
  .sea { fill: #cfe6ee; }
  .waves { fill: none; stroke: #9cc9d8; stroke-width: 3; stroke-linecap: round; }
  .dunes { fill: #ead9b4; }
  .polder { fill: #dcebd9; }
  .town { fill: var(--forest-700); }
  .town-label { font: 600 15px var(--font-body); fill: var(--forest-700); }
  .town-label--far { fill: var(--muted); font-weight: 500; }
  .sea-label { font: italic 500 13px var(--font-body); fill: #5f8fa0; }
  .route-line {
    fill: none;
    stroke: var(--orange-500);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 2 12;
    animation: dash 12s linear infinite;
  }
  .route-line--b { stroke: var(--forest-500); }
  @keyframes dash {
    to { stroke-dashoffset: -280; }
  }
  .pin__dot { fill: var(--forest-900); stroke: var(--white); stroke-width: 3; }
  .pin__pulse { fill: var(--orange-500); opacity: 0.35; transform-box: fill-box; transform-origin: center; animation: pulse 2.4s ease-out infinite; }
  .pin__no { font: 750 14px var(--font-body); fill: var(--white); text-anchor: middle; }
  .pin__label { font: 700 16px var(--font-display); fill: var(--forest-900); paint-order: stroke; stroke: #f7f1e4; stroke-width: 5px; }
  .pin:hover .pin__dot { fill: var(--orange-600); }
  @keyframes pulse {
    0% { transform: scale(0.8); opacity: 0.5; }
    100% { transform: scale(1.9); opacity: 0; }
  }
</style>
