---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import { site } from '../config';

interface Props {
  title: string;
  description: string;
  /** Titulek bez přípony „| Kickbike Club Hille“ */
  fullTitle?: boolean;
  image?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  jsonLd?: object | object[];
}

const { title, description, fullTitle = false, image = site.ogImage, type = 'website', noindex = false, jsonLd } = Astro.props;
const pageTitle = fullTitle ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const locale = site.lang === 'nl' ? 'nl_NL' : 'cs_CZ';
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#12352b" />

    <meta property="og:type" content={type === 'product' ? 'product' : type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="NL-NH" />
    <meta name="geo.placename" content={site.city} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Přeskočit na obsah</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCta />
  </body>
</html>
