---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
import { t } from '../i18n/ui';
---
<BaseLayout title="Bedankt voor je bericht" description="Je bericht is ontvangen." noindex>
  <section class="section">
    <div class="container" style="max-width:720px;text-align:center">
      <span class="eyebrow">Verzonden</span>
      <h1>Bedankt, je bericht is ontvangen!</h1>
      <p class="lead" style="margin-inline:auto">Ik neem zo snel mogelijk contact met je op. Haast? Stuur me direct een WhatsApp-bericht.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--whatsapp" href={site.whatsapp} target="_blank" rel="noopener">{t('cta.whatsapp')}</a>
        <a class="btn btn--secondary" href="/">Terug naar home</a>
      </div>
      <p class="gift-tip">🎁 Ken je iemand die steppen leuk zou vinden? <a href="/cadeaubon/">Geef een cadeaubon →</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .gift-tip {
    margin-top: 40px;
    padding: 16px 20px;
    border-radius: var(--radius);
    background: var(--orange-100);
  }
</style>
