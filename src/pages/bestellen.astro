---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import { shop, site } from '../config';
import { formatPrice } from '../i18n/ui';
import { getCatalog } from '../lib/shop';
import { breadcrumbSchema } from '../lib/schema';
import Quiz from '../components/Quiz.astro';

const crumbs = [{ name: 'Bestellen', href: '/bestellen/' }];
const catalog = await getCatalog();
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const steps = catalog.filter((c) => c.kind === 'step');
const accessories = catalog.filter((c) => c.kind === 'acc' && c.available);
// Ceny pro živý souhrn v prohlížeči (finální cenu vždy počítá server).
const prices = Object.fromEntries(catalog.map((c) => [c.key, { title: c.title, price: c.price }]));
const shipping = shop.shipping.map((s) => ({ id: s.id, label: s.label, price: s.price, freeFrom: s.freeFrom, needsAddress: s.needsAddress }));
---
<BaseLayout
  title="Sportstep bestellen"
  description="Bestel een Crussis sportstep of accessoires. Betalen per overboeking, levering binnen ca. 10 werkdagen of ophalen in Haarlem met persoonlijk afsteladvies."
  jsonLd={breadcrumbSchema(crumbs)} 
  hideMobileCta
>
  <PageHero eyebrow="Webshop" title="Bestellen" lead={`Kies je step en accessoires, vul je adres in en klaar. Betalen per overboeking, levering ${shop.deliveryTime}.`} crumbs={crumbs} />

  <section class="section" style="padding-top:0">
    <div class="container">
      <Todo>Cena dopravy (zatím „upřesníme e-mailem“), IBAN a úplná adresa firmy se doplní v src/config.ts. Tlačítko v NL verzi musí znít „Bestelling plaatsen met betaalverplichting“.</Todo>
      <form class="order" method="POST" action="/api/bestelling/" novalidate data-prices={JSON.stringify(prices)} data-shipping={JSON.stringify(shipping)}>
        <div class="order__main">
          <fieldset class="card">
            <legend><span class="step-no">1</span> Sportstep</legend>
            <div class="field">
              <label for="step">Model en variant</label>
              <select id="step" name="step">
                <option value="">— geen step (alleen accessoires) —</option>
                {products.map((p) => (
                  <optgroup label={p.data.title}>
                    {steps.filter((s) => s.key.startsWith(`step:${p.id}|`)).map((s) => (
                      <option value={s.key} disabled={!s.available} data-product={p.id}>
                        {s.title} – {formatPrice(s.price)}{!s.available ? ' (uitverkocht)' : ''}
                      </option>
                    ))}
                  </optgroup>
                ))}
              </select>
              <p class="field__error" data-error-for="step"></p>
            </div>
            <div class="field field--qty">
              <label for="qty">Aantal</label>
              <input id="qty" name="qty" type="number" min="1" max={shop.maxQty} value="1" inputmode="numeric" />
            </div>
            <button type="button" class="quiz-open" data-quiz-open>
              <span aria-hidden="true">?</span>
              <span><strong>Twijfel je welk model?</strong> Doe de test van 30 seconden – we kiezen het model meteen voor je.</span>
            </button>
            <p class="hint"><Icon name="check" size={16} /> Of <a href="/proefrit-en-lessen/">probeer hem eerst uit</a> of <a href={site.whatsapp} target="_blank" rel="noopener">stuur Linda een bericht</a>.</p>
          </fieldset>

          <fieldset class="card">
            <legend><span class="step-no">2</span> Accessoires <span class="opt">(optioneel)</span></legend>
            <div class="accs">
              {accessories.map((a) => (
                <label class="acc">
                  <input type="checkbox" name="acc" value={a.key} />
                  <span class="acc__title">{a.title}</span>
                  <span class="acc__price">{formatPrice(a.price)}</span>
                </label>
              ))}
            </div>
            <p class="field__error" data-error-for="acc"></p>
          </fieldset>

          <fieldset class="card">
            <legend><span class="step-no">3</span> Levering</legend>
            <div class="ship">
              {shop.shipping.map((s, i) => (
                <label class="ship__opt">
                  <input type="radio" name="shipping" value={s.id} checked={i === 0} />
                  <span>
                    <strong>{s.label}</strong>
                    <small>{s.price === null ? 'verzendkosten bevestigen we per e-mail' : s.price === 0 ? 'gratis' : formatPrice(s.price)}{s.price && s.freeFrom ? ` · gratis vanaf ${formatPrice(s.freeFrom)}` : ''}</small>
                  </span>
                </label>
              ))}
            </div>
            <p class="field__error" data-error-for="shipping"></p>
            <p class="hint"><Icon name="calendar" size={16} /> Levering {shop.deliveryTime} na ontvangst van de betaling.</p>
          </fieldset>

          <fieldset class="card">
            <legend><span class="step-no">4</span> Contactgegevens en adres</legend>
            <div class="grid-2">
              <div class="field">
                <label for="name">Voor- en achternaam</label>
                <input id="name" name="name" autocomplete="name" required />
                <p class="field__error" data-error-for="name"></p>
              </div>
              <div class="field">
                <label for="phone">Telefoon <span class="opt">(aanbevolen)</span></label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" />
                <p class="field__error" data-error-for="phone"></p>
              </div>
            </div>
            <div class="field">
              <label for="email">E-mailadres</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
              <p class="field__error" data-error-for="email"></p>
            </div>
            <div class="address" data-address>
              <div class="field">
                <label for="street">Straat en huisnummer</label>
                <input id="street" name="street" autocomplete="street-address" />
                <p class="field__error" data-error-for="street"></p>
              </div>
              <div class="grid-2">
                <div class="field">
                  <label for="postcode">Postcode</label>
                  <input id="postcode" name="postcode" autocomplete="postal-code" placeholder="2132 AB" />
                  <p class="field__error" data-error-for="postcode"></p>
                </div>
                <div class="field">
                  <label for="city">Plaats</label>
                  <input id="city" name="city" autocomplete="address-level2" />
                  <p class="field__error" data-error-for="city"></p>
                </div>
              </div>
            </div>
            <div class="field">
              <label for="note">Opmerking <span class="opt">(optioneel)</span></label>
              <textarea id="note" name="note" rows="3" placeholder="Bijvoorbeeld je lichaamslengte voor het afstellen of een voorkeursdatum om op te halen…"></textarea>
            </div>
            <p class="visually-hidden"><label>Niet invullen: <input name="website" tabindex="-1" autocomplete="off" /></label></p>
          </fieldset>
        </div>

        <aside class="order__summary card">
          <h2>Overzicht</h2>
          <ul class="sum" data-summary>
            <li class="sum__empty">Nog niets gekozen.</li>
          </ul>
          <dl class="totals">
            <dt>Verzendkosten</dt><dd data-shipping-price>—</dd>
            <dt class="totals__grand">Totaal incl. btw</dt><dd class="totals__grand" data-total>{formatPrice(0)}</dd>
          </dl>
          <p class="pay"><Icon name="check" size={16} /> Betalen per overboeking binnen {shop.paymentDays} dagen. Je ontvangt de betaalgegevens direct na je bestelling.</p>
          <label class="consent">
            <input type="checkbox" name="terms" required />
            <span>Ik ga akkoord met de <a href="/algemene-voorwaarden/" target="_blank">algemene voorwaarden</a> en heb het <a href="/privacybeleid/" target="_blank">privacybeleid</a> gelezen.</span>
          </label>
          <p class="field__error" data-error-for="terms"></p>
          <button class="btn btn--primary order__submit" type="submit">Bestelling plaatsen met betaalverplichting</button>
          <p class="form-error" data-form-error role="alert"></p>
        </aside>
      </form>
    </div>
  </section>

  <dialog class="quiz-dialog" data-quiz-dialog aria-labelledby="quiz-dialog-title">
    <div class="quiz-dialog__head">
      <h2 id="quiz-dialog-title">Welke step past bij mij?</h2>
      <button type="button" class="quiz-dialog__close" data-quiz-close aria-label="Test sluiten">×</button>
    </div>
    <Quiz mode="pick" />
  </dialog>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('form.order')!;
  const prices: Record<string, { title: string; price: number }> = JSON.parse(form.dataset.prices!);
  const shipping: { id: string; price: number | null; freeFrom: number | null; needsAddress: boolean }[] = JSON.parse(form.dataset.shipping!);
  const fmt = new Intl.NumberFormat(document.documentElement.lang === 'nl' ? 'nl-NL' : 'cs-CZ', { style: 'currency', currency: 'EUR' });
  const stepSelect = form.querySelector<HTMLSelectElement>('#step')!;
  const qtyInput = form.querySelector<HTMLInputElement>('#qty')!;
  const addressBox = form.querySelector<HTMLElement>('[data-address]')!;

  // Předvýběr z odkazu: /bestellen/?item=<produkt> nebo ?acc=<doplněk>
  const params = new URLSearchParams(location.search);
  const item = params.get('item');
  if (item) {
    const opt = [...stepSelect.options].find((o) => o.dataset.product === item && !o.disabled);
    if (opt) stepSelect.value = opt.value;
  }
  const acc = params.get('acc');
  if (acc) {
    const box = form.querySelector<HTMLInputElement>(`input[name="acc"][value="acc:${CSS.escape(acc)}"]`);
    if (box) box.checked = true;
  }

  function update() {
    const lines: { title: string; total: number }[] = [];
    const qty = Math.max(1, Math.min(Number(qtyInput.max), Number(qtyInput.value) || 1));
    if (stepSelect.value && prices[stepSelect.value]) {
      const p = prices[stepSelect.value];
      lines.push({ title: `${qty}× ${p.title}`, total: p.price * qty });
    }
    form.querySelectorAll<HTMLInputElement>('input[name="acc"]:checked').forEach((box) => {
      const p = prices[box.value];
      if (p) lines.push({ title: p.title, total: p.price });
    });
    const ship = shipping.find((s) => s.id === (form.querySelector<HTMLInputElement>('input[name="shipping"]:checked')?.value ?? ''));
    const subtotal = lines.reduce((s, l) => s + l.total, 0);
    const summary = form.querySelector('[data-summary]')!;
    summary.innerHTML = '';
    if (lines.length === 0) summary.innerHTML = '<li class="sum__empty">Nog niets gekozen.</li>';
    for (const l of lines) {
      const li = document.createElement('li');
      const name = document.createElement('span');
      name.textContent = l.title;
      const price = document.createElement('span');
      price.textContent = fmt.format(l.total);
      li.append(name, price);
      summary.append(li);
    }
    const shipPrice = ship && ship.price !== null && ship.freeFrom !== null && subtotal >= ship.freeFrom ? 0 : ship?.price ?? null;
    form.querySelector('[data-shipping-price]')!.textContent = !ship ? '—' : shipPrice === null ? 'volgt per e-mail' : shipPrice === 0 ? 'gratis' : fmt.format(shipPrice);
    form.querySelector('[data-total]')!.textContent = fmt.format(subtotal + (shipPrice ?? 0));
    addressBox.hidden = !ship?.needsAddress;
  }
  // Kvíz v okně: výsledek vybere model ve formuláři
  const dialog = document.querySelector<HTMLDialogElement>('[data-quiz-dialog]');
  document.querySelector('[data-quiz-open]')?.addEventListener('click', () => dialog?.showModal());
  dialog?.querySelector('[data-quiz-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close(); // klik mimo obsah
  });
  dialog?.addEventListener('quiz:pick', (e) => {
    const product = (e as CustomEvent<{ product: string }>).detail.product;
    const opt = [...stepSelect.options].find((o) => o.dataset.product === product && !o.disabled);
    if (opt) {
      stepSelect.value = opt.value;
      stepSelect.dispatchEvent(new Event('change', { bubbles: true }));
      stepSelect.classList.add('flash');
      window.setTimeout(() => stepSelect.classList.remove('flash'), 1600);
    }
    dialog.close();
    stepSelect.focus();
  });

  form.addEventListener('input', update);
  // Po opravě pole zmizí jeho chybová hláška.
  const clearError = (e: Event) => {
    const name = (e.target as HTMLInputElement).name;
    const el = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    if (el) el.textContent = '';
  };
  form.addEventListener('input', clearError);
  form.addEventListener('change', clearError);
  form.addEventListener('change', update);
  update();

  function showErrors(errors: Record<string, string>) {
    form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
      el.textContent = errors[el.dataset.errorFor!] ?? '';
    });
    const first = Object.keys(errors)[0];
    if (!first) return;
    const target = form.querySelector<HTMLElement>(`[name="${first}"]`) ?? form.querySelector<HTMLElement>(`[data-error-for="${first}"]`);
    target?.scrollIntoView({ block: 'center' });
    target?.focus();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('.order__submit')!;
    const formError = form.querySelector<HTMLElement>('[data-form-error]')!;
    formError.textContent = '';
    button.disabled = true;
    button.textContent = 'Bezig met verzenden…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = await res.json();
      if (data.ok) {
        location.href = data.redirect;
        return;
      }
      showErrors(data.errors ?? {});
      if (data.message) formError.textContent = data.message;
    } catch {
      formError.textContent = 'Je bestelling kon niet worden verzonden. Probeer het opnieuw of stuur Linda een WhatsApp-bericht.';
    }
    button.disabled = false;
    button.textContent = 'Bestelling plaatsen met betaalverplichting';
  });
</script>

<style>
  .order {
    display: grid;
    gap: 24px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .order {
      grid-template-columns: 1.5fr 1fr;
    }
    .order__summary {
      position: sticky;
      top: 96px;
    }
  }
  .order__main {
    display: grid;
    gap: 20px;
  }
  fieldset {
    margin: 0;
    min-width: 0;
  }
  legend {
    float: left;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--forest-900);
    margin-bottom: 18px;
  }
  legend + * {
    clear: both;
  }
  .step-no {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--forest-900);
    color: var(--white);
    font-size: 0.95rem;
  }
  .opt {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .field {
    display: grid;
    gap: 6px;
    margin-bottom: 14px;
  }
  .field--qty input {
    max-width: 120px;
  }
  .grid-2 {
    display: grid;
    gap: 0 16px;
  }
  @media (min-width: 640px) {
    .grid-2 {
      grid-template-columns: 1fr 1fr;
    }
  }
  label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--forest-900);
  }
  input:not([type='checkbox']):not([type='radio']),
  select,
  textarea {
    font: inherit;
    width: 100%;
    padding: 0.75em 0.9em;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--sand-50);
    color: var(--ink);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--forest-500);
    box-shadow: 0 0 0 4px var(--forest-100);
  }
  .field__error,
  .form-error {
    margin: 0;
    color: #b42318;
    font-size: 0.88rem;
    font-weight: 500;
  }
  .field__error:empty,
  .form-error:empty {
    display: none;
  }
  .hint {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    margin: 4px 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .quiz-open {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 4px 0 10px;
    padding: 14px 16px;
    border-radius: var(--radius);
    border: 1px solid #f6c3a8;
    background: linear-gradient(120deg, #fff1e8 0%, #ffe3d1 100%);
    font: inherit;
    font-size: 0.95rem;
    text-align: left;
    color: var(--ink-soft);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .quiz-open:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  .quiz-open > span:first-child {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--orange-500);
    color: var(--accent-ink);
    font: 800 1.3rem var(--font-display);
    transform: rotate(-6deg);
  }
  .quiz-open strong {
    color: var(--forest-900);
  }
  select.flash {
    animation: flash 1.6s ease;
  }
  @keyframes flash {
    0%, 60% { border-color: var(--orange-500); box-shadow: 0 0 0 5px rgb(255 122 61 / 0.3); }
    100% { box-shadow: none; }
  }
  .quiz-dialog {
    width: min(960px, calc(100% - 24px));
    max-height: calc(100dvh - 24px);
    border: 0;
    border-radius: var(--radius-lg);
    padding: clamp(18px, 3vw, 32px);
    background: var(--white);
    box-shadow: 0 40px 100px -30px rgb(0 0 0 / 0.45);
  }
  .quiz-dialog::backdrop {
    background: rgb(11 35 28 / 0.55);
    backdrop-filter: blur(3px);
  }
  .quiz-dialog__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }
  .quiz-dialog__head h2 {
    margin: 0;
    font-size: 1.3rem;
  }
  .quiz-dialog__close {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--sand-50);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    color: var(--forest-900);
  }
  .accs {
    display: grid;
    gap: 8px;
  }
  .acc,
  .ship__opt {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    font-weight: 500;
    cursor: pointer;
    background: var(--sand-50);
  }
  .acc:has(input:checked),
  .ship__opt:has(input:checked) {
    border-color: var(--forest-500);
    background: var(--forest-100);
  }
  .acc input,
  .ship__opt input {
    width: 20px;
    height: 20px;
    flex: none;
    accent-color: var(--forest-700);
  }
  .acc__title {
    flex: 1;
  }
  .acc__price {
    font-weight: 650;
    white-space: nowrap;
  }
  .ship {
    display: grid;
    gap: 8px;
  }
  .ship__opt span {
    display: flex;
    flex-direction: column;
  }
  .ship__opt small {
    font-weight: 400;
    color: var(--muted);
  }
  .address[hidden] {
    display: none;
  }
  .order__summary h2 {
    font-size: 1.4rem;
  }
  .sum {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: grid;
    gap: 8px;
  }
  .sum :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.95rem;
  }
  .sum :global(.sum__empty) {
    color: var(--muted);
  }
  .totals {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px 12px;
    margin: 0 0 16px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .totals dd {
    margin: 0;
    text-align: right;
  }
  .totals__grand {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.3rem;
    color: var(--forest-900);
    margin-top: 6px;
  }
  .pay {
    display: flex;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .consent input {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    flex: none;
    accent-color: var(--forest-700);
  }
  .order__submit {
    width: 100%;
    margin-top: 8px;
    white-space: normal;
  }
  .order__submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .form-error {
    margin-top: 10px;
  }
</style>
