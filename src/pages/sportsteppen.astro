---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import imgDetail from '../assets/photos/crussis-cross-detail-bos.jpg';
import imgGroep from '../assets/photos/clubrit-groep.jpg';
import Icon from '../components/Icon.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import SportInfographic from '../components/SportInfographic.astro';
import { bookingHref } from '../config';
import { t } from '../i18n/ui';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const crumbs = [{ name: 'Sportsteppen', href: '/sportsteppen/' }];
const faq = (await getCollection('faq')).filter((f) => f.data.topic === 'zdravi' || f.id === 'wat-is').map((f) => f.data);

---
<BaseLayout
  title="Wat is sportsteppen? Gewrichtsvriendelijke training voor je hele lichaam"
  description="Sportsteppen (kickbike, footbike) is een effectieve training voor je hele lichaam zonder schokken. Beter voor je conditie, vriendelijk voor je gewrichten en geschikt voor beginners, ouderen en na een blessure."
  jsonLd={[breadcrumbSchema(crumbs), faqSchema(faq)]}
>
  <PageHero eyebrow="Sportsteppen" title="Training voor je hele lichaam, vriendelijk voor je gewrichten" lead="Sportsteppen is rijden op een sportstep met een groot voorwiel. Je zet je afwisselend met beide benen af, gebruikt je hele lichaam – en je bent buiten." crumbs={crumbs}>
    <div class="btn-row">
      <a class="btn btn--primary" href={bookingHref}>{t('cta.book')}</a>
    </div>
    <Photo slot="aside" src={imgDetail} alt="Detail van de treeplank en het voorwiel van een Crussis terreinstep in het bos" ratio="4 / 3" priority />
  </PageHero>

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Wat steppen je oplevert</span>
        <h2>Effectief bewegen, laagdrempelig</h2>
        <ul class="checklist">
          <li>je verbetert je conditie</li>
          <li>je gebruikt en verstevigt je hele lichaam</li>
          <li>je belast je gewrichten minder dan bij hardlopen</li>
          <li>je kunt overbodige kilo’s kwijtraken</li>
          <li>je traint je balans en coördinatie</li>
          <li>en je bent ondertussen lekker buiten</li>
        </ul>
      </div>
      <div class="card">
        <h3>Voor wie is steppen geschikt?</h3>
        <ul class="checklist">
          <li>beginners en herstarters</li>
          <li>jong en oud</li>
          <li>mensen die willen bewegen zonder overbelasting</li>
          <li>mensen die revalideren na een operatie of blessure (in overleg met je arts)</li>
          <li>mensen die graag willen afvallen</li>
          <li>iedereen die fitter wil worden</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Vergelijking</span>
        <h2>Steppen vs. hardlopen vs. fietsen</h2>
        <p class="lead">Steppen combineert het beste van twee werelden: de intensiteit van hardlopen en de gewrichtsvriendelijkheid van fietsen – en daarbij werkt je hele lichaam mee.</p>
      </div>
      <SportInfographic />
      <p style="margin-top:20px"><a href="/blog/steppen-vs-hardlopen/">Lees meer: steppen vs. hardlopen →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container split split--reverse">
      <div>
        <span class="eyebrow">Een beetje geschiedenis</span>
        <h2>Van biatlontraining naar parken in heel Europa</h2>
        <p>Sportsteppen is ontstaan uit de behoefte van professionele biatleten om ook in de zomer te trainen. In Tsjechië is het inmiddels erg populair en wordt het steeds vaker aangeraden door zorgprofessionals – vanwege de voordelen voor de gezondheid en bij revalidatie.</p>
        <p>Nederland is een stepland bij uitstek: vlak, vol fietspaden, parken en duinen. Alleen is het steppen hier wat in de vergetelheid geraakt. Daar brengen we verandering in.</p>
      </div>
      <Photo src={imgGroep} alt="Samen steppen over het fietspad" ratio="4 / 5" position="50% 60%" />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container narrow">
      <div class="section-head">
        <span class="eyebrow">Gezondheid & veelgestelde vragen</span>
        <h2>Wat mensen het vaakst vragen</h2>
      </div>
      <FaqList items={faq} />
      <p style="margin-top:20px"><a href="/veelgestelde-vragen/">Alle vragen <Icon name="arrow" size={16} class="inline-icon" /></a></p>
    </div>
  </section>

  <CtaBand title="Je hoeft niet fit te zijn om te beginnen." text="Je begint om fitter te worden. Boek een proefrit en ontdek of sportsteppen bij je past." />
</BaseLayout>

<style>
  .narrow {
    max-width: 860px;
  }
  :global(.inline-icon) {
    display: inline;
    vertical-align: -3px;
  }
</style>
