---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import BikeAnatomy from '../../components/BikeAnatomy.astro';
import QuizTeaser from '../../components/QuizTeaser.astro';
import { bookingHref, site } from '../../config';
import { t } from '../../i18n/ui';
import { breadcrumbSchema } from '../../lib/schema';

const crumbs = [{ name: 'Sportsteps', href: '/sportsteps/' }];
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

const groups = [
  { id: 'recreatief', title: 'Recreatief', text: 'Voor beginners en ontspannen tochten. Comfortabele houding, stabiel en makkelijk te besturen.', icon: 'sun' },
  { id: 'sport', title: 'Sportief', text: 'Voor conditietraining en langere afstanden. Betere krachtoverbrenging, vlot rijden.', icon: 'bolt' },
  { id: 'cross', title: 'Terrein', text: 'Voor bos, duinen en grind. Robuust gebouwd voor een uitdaging.', icon: 'route' },
] as const;

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${site.url}/sportsteps/${p.id}/`,
    name: p.data.title,
  })),
};
---
<BaseLayout
  title="Sportstep kopen – Crussis Road, Cobra en Cross"
  description="Crussis sportsteps met persoonlijk advies: de recreatieve Road, de sportieve Cobra en de Cross voor het terrein. Probeer ze eerst uit tijdens een gratis proefrit in Haarlem."
  jsonLd={[breadcrumbSchema(crumbs), listSchema]}
>
  <PageHero eyebrow="Crussis sportsteps" title="Vind de step die bij jou past" lead="De sportsteps van de Tsjechische fabrikant Crussis zijn ontworpen voor volwassen rijders – voor vlakke stadsstraten én onverharde wegen. Hoogwaardige afwerking, een solide constructie, een laag gewicht en comfortabele rijeigenschappen." crumbs={crumbs}>
    <div class="btn-row">
      <a class="btn btn--primary" href="/bestellen/">Online bestellen</a>
      <a class="btn btn--secondary" href={bookingHref}>Eerst uitproberen</a>
      <a class="btn btn--secondary" href="/welke-step/">Test: welke past bij mij?</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <QuizTeaser class="quiz-teaser" />
      {groups.map((g) => {
        const items = products.filter((p) => p.data.category === g.id);
        return items.length > 0 && (
          <div class="group" id={g.id}>
            <div class="group__head">
              <div class="group__icon"><Icon name={g.icon} /></div>
              <div>
                <h2>{g.title}</h2>
                <p>{g.text}</p>
              </div>
            </div>
            <div class="grid grid--3">
              {items.map((p) => <ProductCard product={p} />)}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="section section--tint" id="anatomie">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Anatomie van een sportstep</span>
        <h2>Wat een sportstep zo sportief maakt</h2>
        <p class="lead">Klik op de nummers op de foto en ontdek waarom je op een grote step zo soepel rijdt – en wat het verschil is met een kinder- of stadsstep.</p>
      </div>
      <BikeAnatomy />
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Waarom bij ons</span>
        <h2>Geen anonieme webshop, maar persoonlijk advies</h2>
        <ul class="checklist">
          <li>je probeert de step uit voordat je hem koopt</li>
          <li>ik adviseer je over het model op basis van je doelen en routes</li>
          <li>ik stel de step voor je af</li>
          <li>ik leg het onderhoud uit</li>
          <li>als klant step je gratis mee met de club</li>
        </ul>
        <p>Naast de modellen in het aanbod zijn er nog andere kleurvarianten beschikbaar – <a href="/contact/?onderwerp=sportstep">vraag ernaar</a>. Bestellen is eenvoudig: je kiest een model, vult je adres in en betaalt per overboeking.</p>
      </div>
      <div class="card">
        <h3>Goed om te weten</h3>
        <p>Crussis-steps hebben een frame van aluminium, staal of carbon en klassieke Tektro-velgremmen – zelfs met een geïntegreerde bel. Zoals de meeste sportsteps zijn ze niet inklapbaar.</p>
        <p>Een standaard is niet standaard meegeleverd – die kun je apart bestellen, net als andere <a href="/accessoires/">accessoires</a>.</p>
        <a class="btn btn--secondary" href="/accessoires/">{t('footer.accessories')}</a>
      </div>
    </div>
  </section>

  <CtaBand title="Twijfel je welk model bij je past?" text="Tijdens een proefrit probeer je de Road, Cobra en Cross uit – en binnen een uur weet je welke bij je past." />
</BaseLayout>

<style>
  :global(.quiz-teaser) {
    margin-bottom: clamp(40px, 6vw, 64px);
  }
  .group + .group {
    margin-top: clamp(56px, 8vw, 96px);
  }
  .group__head {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    margin-bottom: 28px;
  }
  .group__head h2 {
    margin-bottom: 4px;
  }
  .group__head p {
    margin: 0;
    color: var(--muted);
  }
  .group__icon {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: var(--forest-900);
    color: var(--orange-500);
  }
</style>
