---
import BaseLayout from '../layouts/BaseLayout.astro';
import KickbikeArt from '../components/KickbikeArt.astro';
---
<BaseLayout title="Pagina niet gevonden" description="Deze pagina bestaat niet." noindex>
  <section class="section">
    <div class="container" style="max-width:720px;text-align:center">
      <div style="background:var(--forest-900);border-radius:var(--radius-lg);padding:24px;max-width:360px;margin:0 auto 32px">
        <KickbikeArt />
      </div>
      <h1>Hier houdt de route op</h1>
      <p class="lead" style="margin-inline:auto">De pagina die je zoekt bestaat niet of is verhuisd.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href="/">Naar home</a>
        <a class="btn btn--secondary" href="/sportsteps/">Sportsteps</a>
      </div>
    </div>
  </section>
</BaseLayout>
