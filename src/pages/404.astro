---
import BaseLayout from '../layouts/BaseLayout.astro';
import KickbikeArt from '../components/KickbikeArt.astro';
---
<BaseLayout title="Stránka nenalezena" description="Tahle stránka neexistuje." noindex>
  <section class="section">
    <div class="container" style="max-width:720px;text-align:center">
      <div style="background:var(--forest-900);border-radius:var(--radius-lg);padding:24px;max-width:360px;margin:0 auto 32px">
        <KickbikeArt />
      </div>
      <h1>Tady cesta končí</h1>
      <p class="lead" style="margin-inline:auto">Stránka, kterou hledáš, neexistuje nebo se přestěhovala.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href="/">Na úvod</a>
        <a class="btn btn--secondary" href="/sportsteps/">Koloběžky</a>
      </div>
    </div>
  </section>
</BaseLayout>
