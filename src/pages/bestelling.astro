---
// Potvrzení objednávky (na serveru). Přístup jen s číslem objednávky + tajným tokenem z odkazu.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import { shop, site } from '../config';
import { getOrder } from '../lib/orders';
import { formatCents } from '../lib/shop';
import { mailConfigured } from '../lib/mail';

export const prerender = false;

const nr = Astro.url.searchParams.get('nr') ?? '';
const token = Astro.url.searchParams.get('t') ?? '';
const found = nr && token ? await getOrder(nr) : null;
const order = found && found.token === token ? found : null;
if (!order) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');

const isVoucher = order?.meta.type === 'voucher';
const voucherPaid = order ? ['betaald', 'besteld', 'verzonden'].includes(order.status) : false;
const voucherUrl = order ? `/cadeaubon/bekijken/?nr=${encodeURIComponent(order.number)}&t=${order.token}` : '';
const shippingText = (cents: number | null) => (cents === null ? 'volgt per e-mail' : cents === 0 ? 'gratis' : formatCents(cents));
---
<BaseLayout title={order ? `Bestelling ${order.number}` : 'Bestelling niet gevonden'} description="Bevestiging van je bestelling." noindex hideMobileCta>
  <section class="section">
    <div class="container confirm">
      {order ? (
        <>
          <div class="confirm__head">
            <span class="confirm__icon"><Icon name="check" size={32} /></span>
            <span class="eyebrow">Bestelling ontvangen</span>
            <h1>Bedankt, {order.name.split(' ')[0]}!</h1>
            <p class="lead">
              Je bestelling <strong>{order.number}</strong> is ontvangen.
              {mailConfigured() ? ` We sturen de bevestiging ook naar ${order.email}.` : ' Bewaar deze pagina – Linda neemt binnenkort per e-mail contact met je op.'}
            </p>
          </div>

          <div class="confirm__grid">
            <div class="card">
              <h2>Betalen per overboeking</h2>
              {shop.bank.iban ? (
                <dl class="pay">
                  <dt>Bedrag</dt><dd><strong>{formatCents(order.totalCents)}</strong></dd>
                  <dt>Rekening (IBAN)</dt><dd>{shop.bank.iban}</dd>
                  <dt>Ten name van</dt><dd>{shop.bank.accountName}</dd>
                  {shop.bank.bic && (<><dt>BIC</dt><dd>{shop.bank.bic}</dd></>)}
                  <dt>Omschrijving</dt><dd><strong>{order.number}</strong></dd>
                  <dt>Betaaltermijn</dt><dd>{shop.paymentDays} dagen</dd>
                </dl>
              ) : (
                <>
                  <p>De betaalgegevens (IBAN) sturen we je per e-mail. Vermeld bij de betaling je bestelnummer <strong>{order.number}</strong>.</p>
                  <Todo>Doplnit IBAN do src/config.ts (shop.bank).</Todo>
                </>
              )}
              {order.shippingCents === null && (
                <p class="note">De verzendkosten bevestigen we per e-mail – betaal pas daarna het volledige bedrag.</p>
              )}
            </div>

            <div class="card">
              <h2>Hoe gaat het verder?</h2>
              {isVoucher ? (
                <ol class="next">
                  <li>Na ontvangst van de betaling activeren we de cadeaubon.</li>
                  <li>Je ontvangt per e-mail een link naar de bon – om te printen of door te sturen.</li>
                  <li>De ontvanger maakt een afspraak met Linda en vermeldt de code van de bon.</li>
                </ol>
              ) : (
                <ol class="next">
                  <li>Na ontvangst van de betaling bestellen we de step bij de fabrikant.</li>
                  <li>Levering {shop.deliveryTime} – we laten je weten wanneer.</li>
                  <li>{order.shipping === 'ophalen' ? 'Bij het ophalen stellen we je step af en leggen we het onderhoud uit.' : 'Na de levering nemen we contact op en helpen we je met het afstellen.'}</li>
                  <li>Als klant doe je gratis mee aan de <a href="/club/">clubritten</a>.</li>
                </ol>
              )}
              {isVoucher && (
                <p class="voucher-link"><a class="btn btn--secondary" href={voucherUrl}>{voucherPaid ? 'Cadeaubon openen om te printen' : 'Voorbeeld van de bon'}</a></p>
              )}
            </div>
          </div>

          <div class="card summary">
            <h2>Overzicht van je bestelling</h2>
            <table>
              <tbody>
                {order.lines.map((l) => (
                  <tr><td>{l.qty}× {l.title}</td><td>{formatCents(l.totalCents)}</td></tr>
                ))}
                <tr><td>{order.shippingLabel}</td><td>{shippingText(order.shippingCents)}</td></tr>
              </tbody>
              <tfoot>
                <tr><th>Totaal incl. btw</th><th>{formatCents(order.totalCents)}</th></tr>
              </tfoot>
            </table>
            {isVoucher && (
              <p class="addr"><strong>Op de bon:</strong> € {order.meta.amount} voor {order.meta.recipient || '–'}{order.meta.message && <><br /><em>„{order.meta.message}”</em></>}</p>
            )}
            <p class="addr">
              <strong>{isVoucher ? 'Koper' : order.shipping === 'ophalen' ? 'Contactgegevens' : 'Bezorgadres'}:</strong><br />
              {order.name}<br />
              {order.street && (<>{order.street}<br />{order.postcode} {order.city}<br /></>)}
              {order.phone && (<>{order.phone}<br /></>)}
              {order.email}
            </p>
            {!isVoucher && (
              <p class="gift-tip">🎁 Ken je iemand die steppen leuk zou vinden? <a href="/cadeaubon/">Geef een cadeaubon →</a></p>
            )}
            <p class="small">Je hebt het recht om binnen 14 dagen na ontvangst zonder opgave van redenen de overeenkomst te herroepen – zie de <a href="/algemene-voorwaarden/">algemene voorwaarden</a>. Vragen: <a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>, <a href={site.phoneHref}>{site.phone}</a> of <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
          </div>
        </>
      ) : (
        <div class="confirm__head">
          <h1>Bestelling niet gevonden</h1>
          <p class="lead">De link is ongeldig of onvolledig. Gebruik de link uit de bevestigingsmail of neem contact op met Linda.</p>
          <a class="btn btn--primary" href={site.whatsapp} target="_blank" rel="noopener">WhatsApp sturen</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .confirm {
    max-width: 900px;
  }
  .confirm__head {
    text-align: center;
    margin-bottom: 40px;
  }
  .confirm__head .lead {
    margin-inline: auto;
  }
  .confirm__icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 16px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--forest-100);
    color: var(--forest-700);
  }
  .confirm__grid {
    display: grid;
    gap: 20px;
    margin-bottom: 20px;
  }
  @media (min-width: 800px) {
    .confirm__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  h2 {
    font-size: 1.35rem;
  }
  .pay {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 16px;
    margin: 0;
  }
  .pay dt {
    color: var(--muted);
  }
  .pay dd {
    margin: 0;
    word-break: break-all;
  }
  .note {
    margin-top: 16px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: var(--orange-100);
    font-size: 0.92rem;
  }
  .next {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
  }
  .voucher-link {
    margin: 16px 0 0;
  }
  .summary table {
    width: 100%;
    border-collapse: collapse;
  }
  .summary td,
  .summary th {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  .summary td:last-child,
  .summary th:last-child {
    text-align: right;
    white-space: nowrap;
  }
  .summary tfoot th {
    border-bottom: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--forest-900);
  }
  .addr {
    margin-top: 20px;
  }
  .gift-tip {
    margin: 20px 0 8px;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    background: var(--orange-100);
  }
  .small {
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
