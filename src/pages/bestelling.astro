---
// Potvrzení objednávky (na serveru). Přístup jen s číslem objednávky + tajným tokenem z odkazu.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import { shop, site } from '../config';
import { getOrder } from '../lib/orders';
import { formatCents } from '../lib/shop';
import { mailConfigured } from '../lib/mail';

export const prerender = false;

const nr = Astro.url.searchParams.get('nr') ?? '';
const token = Astro.url.searchParams.get('t') ?? '';
const found = nr && token ? await getOrder(nr) : null;
const order = found && found.token === token ? found : null;
if (!order) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');

const isVoucher = order?.meta.type === 'voucher';
const voucherPaid = order ? ['betaald', 'besteld', 'verzonden'].includes(order.status) : false;
const voucherUrl = order ? `/cadeaubon/bekijken/?nr=${encodeURIComponent(order.number)}&t=${order.token}` : '';
const shippingText = (cents: number | null) => (cents === null ? 'upřesníme e-mailem' : cents === 0 ? 'zdarma' : formatCents(cents));
---
<BaseLayout title={order ? `Objednávka ${order.number}` : 'Objednávka nenalezena'} description="Potvrzení objednávky." noindex hideMobileCta>
  <section class="section">
    <div class="container confirm">
      {order ? (
        <>
          <div class="confirm__head">
            <span class="confirm__icon"><Icon name="check" size={32} /></span>
            <span class="eyebrow">Objednávka přijata</span>
            <h1>Děkujeme, {order.name.split(' ')[0]}!</h1>
            <p class="lead">
              Tvoje objednávka <strong>{order.number}</strong> dorazila.
              {mailConfigured() ? ` Potvrzení posíláme také na ${order.email}.` : ' Ulož si prosím tuto stránku – Linda se ti brzy ozve e-mailem.'}
            </p>
          </div>

          <div class="confirm__grid">
            <div class="card">
              <h2>Platba převodem</h2>
              {shop.bank.iban ? (
                <dl class="pay">
                  <dt>Částka</dt><dd><strong>{formatCents(order.totalCents)}</strong></dd>
                  <dt>Účet (IBAN)</dt><dd>{shop.bank.iban}</dd>
                  <dt>Na jméno</dt><dd>{shop.bank.accountName}</dd>
                  {shop.bank.bic && (<><dt>BIC</dt><dd>{shop.bank.bic}</dd></>)}
                  <dt>Popis platby</dt><dd><strong>{order.number}</strong></dd>
                  <dt>Splatnost</dt><dd>{shop.paymentDays} dní</dd>
                </dl>
              ) : (
                <>
                  <p>Platební údaje (IBAN) ti pošleme e-mailem. Jako popis platby uveď číslo objednávky <strong>{order.number}</strong>.</p>
                  <Todo>Doplnit IBAN do src/config.ts (shop.bank).</Todo>
                </>
              )}
              {order.shippingCents === null && (
                <p class="note">Cenu dopravy ti potvrdíme e-mailem – teprve pak prosím plať celou částku.</p>
              )}
            </div>

            <div class="card">
              <h2>Co bude dál</h2>
              {isVoucher ? (
                <ol class="next">
                  <li>Po přijetí platby poukaz aktivujeme.</li>
                  <li>Pošleme ti e-mailem odkaz na poukaz – vytiskneš ho, nebo pošleš dál.</li>
                  <li>Obdarovaný si domluví termín s Lindou a uvede kód poukazu.</li>
                </ol>
              ) : (
                <ol class="next">
                  <li>Po přijetí platby objednáme koloběžku u výrobce.</li>
                  <li>Dodání {shop.deliveryTime} – ozveme se ti s termínem.</li>
                  <li>{order.shipping === 'ophalen' ? 'Při vyzvednutí ti koloběžku nastavíme na míru a vysvětlíme údržbu.' : 'Po doručení se ti ozveme a poradíme s nastavením.'}</li>
                  <li>Jako zákazník se můžeš zdarma přidat ke <a href="/club/">klubovým jízdám</a>.</li>
                </ol>
              )}
              {isVoucher && (
                <p class="voucher-link"><a class="btn btn--secondary" href={voucherUrl}>{voucherPaid ? 'Otevřít poukaz k tisku' : 'Náhled poukazu'}</a></p>
              )}
            </div>
          </div>

          <div class="card summary">
            <h2>Přehled objednávky</h2>
            <table>
              <tbody>
                {order.lines.map((l) => (
                  <tr><td>{l.qty}× {l.title}</td><td>{formatCents(l.totalCents)}</td></tr>
                ))}
                <tr><td>{order.shippingLabel}</td><td>{shippingText(order.shippingCents)}</td></tr>
              </tbody>
              <tfoot>
                <tr><th>Celkem vč. DPH</th><th>{formatCents(order.totalCents)}</th></tr>
              </tfoot>
            </table>
            {isVoucher && (
              <p class="addr"><strong>Na poukazu:</strong> {order.meta.amount} € pro {order.meta.recipient || '–'}{order.meta.message && <><br /><em>„{order.meta.message}“</em></>}</p>
            )}
            <p class="addr">
              <strong>{isVoucher ? 'Kupující' : order.shipping === 'ophalen' ? 'Kontakt' : 'Doručovací adresa'}:</strong><br />
              {order.name}<br />
              {order.street && (<>{order.street}<br />{order.postcode} {order.city}<br /></>)}
              {order.phone && (<>{order.phone}<br /></>)}
              {order.email}
            </p>
            <p class="small">Od smlouvy můžeš odstoupit do 14 dnů od převzetí zboží bez udání důvodu – viz <a href="/algemene-voorwaarden/">obchodní podmínky</a>. Dotazy: <a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>, <a href={site.phoneHref}>{site.phone}</a> nebo <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
          </div>
        </>
      ) : (
        <div class="confirm__head">
          <h1>Objednávka nenalezena</h1>
          <p class="lead">Odkaz je neplatný nebo neúplný. Použij prosím odkaz z potvrzovacího e-mailu, nebo se ozvi Lindě.</p>
          <a class="btn btn--primary" href={site.whatsapp} target="_blank" rel="noopener">Napsat na WhatsApp</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .confirm {
    max-width: 900px;
  }
  .confirm__head {
    text-align: center;
    margin-bottom: 40px;
  }
  .confirm__head .lead {
    margin-inline: auto;
  }
  .confirm__icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 16px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--forest-100);
    color: var(--forest-700);
  }
  .confirm__grid {
    display: grid;
    gap: 20px;
    margin-bottom: 20px;
  }
  @media (min-width: 800px) {
    .confirm__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  h2 {
    font-size: 1.35rem;
  }
  .pay {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 16px;
    margin: 0;
  }
  .pay dt {
    color: var(--muted);
  }
  .pay dd {
    margin: 0;
    word-break: break-all;
  }
  .note {
    margin-top: 16px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: var(--orange-100);
    font-size: 0.92rem;
  }
  .next {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
  }
  .voucher-link {
    margin: 16px 0 0;
  }
  .summary table {
    width: 100%;
    border-collapse: collapse;
  }
  .summary td,
  .summary th {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  .summary td:last-child,
  .summary th:last-child {
    text-align: right;
    white-space: nowrap;
  }
  .summary tfoot th {
    border-bottom: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--forest-900);
  }
  .addr {
    margin-top: 20px;
  }
  .small {
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
