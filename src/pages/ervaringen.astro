---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Testimonials from '../components/Testimonials.astro';
import Todo from '../components/Todo.astro';
import Photo from '../components/Photo.astro';
import imgDuinen from '../assets/photos/sportsteppen-in-de-duinen.jpg';
import imgGroep from '../assets/photos/clubrit-groep.jpg';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [{ name: 'Reference', href: '/ervaringen/' }];
---
<BaseLayout
  title="Zkušenosti klientů se sportsteppen"
  description="Přečti si, co říkají klienti o zkušebních jízdách a workshopech sportsteppen s Lindou – v parku, lese i v dunách u moře."
  jsonLd={breadcrumbSchema(crumbs)}
>
  <PageHero eyebrow="Reference" title="Co říkají ti, kdo to zkusili" lead="Zkušební jízdy, workshopy a výlety přes duny až k moři – takhle je zažili naši klienti." crumbs={crumbs} />
  <section class="section" style="padding-top:0">
    <div class="container">
      <Todo>Napojit Google recenze (po založení Google Bedrijfsprofiel) a přidat fotky klientů se souhlasem.</Todo>
      <Testimonials />
      <div class="grid grid--2" style="margin-top:28px">
        <Photo src={imgDuinen} alt="Workshop sportsteppen v dunách" ratio="4 / 3" />
        <Photo src={imgGroep} alt="Seznamovací jízda na sportovních koloběžkách" ratio="4 / 3" position="50% 65%" />
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
