---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import { site } from '../../config';
import { breadcrumbSchema } from '../../lib/schema';

const crumbs = [{ name: 'Tipy & články', href: '/blog/' }];
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const dateFmt = new Intl.DateTimeFormat(site.lang === 'nl' ? 'nl-NL' : 'cs-CZ', { dateStyle: 'medium' });
const tones = ['forest', 'sand', 'orange'] as const;
---
<BaseLayout
  title="Tipy & články o sportsteppen"
  description="Praktické tipy o sportsteppen: technika, výběr koloběžky, zdraví, trasy v okolí Hoofddorpu a v dunách."
  jsonLd={breadcrumbSchema(crumbs)}
>
  <PageHero eyebrow="Blog" title="Tipy & články" lead="Vše, co potřebuješ vědět o sportsteppen – od první jízdy po výběr koloběžky." crumbs={crumbs} />
  <section class="section" style="padding-top:0">
    <div class="container grid grid--3">
      {posts.map((post, i) => (
        <a class="post-card" href={`/blog/${post.id}/`}>
          <Photo src={post.data.image} alt={post.data.title} hint={post.data.imageHint} ratio="16 / 10" tone={tones[i % 3]} sizes="(min-width: 900px) 33vw, 100vw" />
          <div class="post-card__body">
            <time datetime={post.data.date.toISOString()}>{dateFmt.format(post.data.date)}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .post-card :global(.photo) {
    border-radius: 0;
  }
  .post-card__body {
    padding: 20px 24px 26px;
  }
  .post-card time {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .post-card h2 {
    font-size: 1.35rem;
    margin: 8px 0;
  }
  .post-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }
</style>
