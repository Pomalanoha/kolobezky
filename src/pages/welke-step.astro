---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Quiz from '../components/Quiz.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [{ name: 'Welke step past bij mij?', href: '/welke-step/' }];
---
<BaseLayout
  title="Welke sportstep past bij mij? Doe de test"
  description="Drie vragen en je weet of de recreatieve Road, de sportieve Cobra of de Cross voor het terrein bij je past. Keuzetest voor een Crussis sportstep."
  jsonLd={breadcrumbSchema(crumbs)}
>
  <PageHero eyebrow="Test · 30 seconden" title="Welke step past bij mij?" lead="Beantwoord drie snelle vragen en we raden je het type step én de concrete modellen aan." crumbs={crumbs} />
  <section class="section" style="padding-top:0">
    <div class="container">
      <Quiz />
    </div>
  </section>
  <CtaBand title="Twijfel je nog? Probeer ze alle drie." text="Tijdens een proefrit rijd je op de Road, Cobra en Cross – en weet je meteen welke bij je past." />
</BaseLayout>
