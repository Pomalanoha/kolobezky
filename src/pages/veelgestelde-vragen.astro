---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const crumbs = [{ name: 'Časté dotazy', href: '/veelgestelde-vragen/' }];
const all = await getCollection('faq');
const topics = [
  { id: 'start', title: 'Začínáme' },
  { id: 'lekce', title: 'Zkušební jízda & lekce' },
  { id: 'zdravi', title: 'Zdraví' },
  { id: 'steps', title: 'Koloběžky' },
] as const;
---
<BaseLayout
  title="Časté dotazy ke sportsteppen"
  description="Odpovědi na nejčastější otázky: musím být fit? Je steppen vhodné pro kolena? Co si vzít na zkušební jízdu? Jakou koloběžku vybrat?"
  jsonLd={[breadcrumbSchema(crumbs), faqSchema(all.map((f) => f.data))]}
>
  <PageHero eyebrow="FAQ" title="Časté dotazy" lead="Nenašel/la jsi odpověď? Napiš mi – ráda poradím." crumbs={crumbs} />
  <section class="section" style="padding-top:0">
    <div class="container faq-page">
      {topics.map((topic) => (
        <div class="faq-group" id={topic.id}>
          <h2>{topic.title}</h2>
          <FaqList items={all.filter((f) => f.data.topic === topic.id).map((f) => f.data)} />
        </div>
      ))}
    </div>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  .faq-page {
    max-width: 860px;
  }
  .faq-group + .faq-group {
    margin-top: 48px;
  }
  .faq-group h2 {
    font-size: 1.6rem;
  }
</style>
