---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const crumbs = [{ name: 'Veelgestelde vragen', href: '/veelgestelde-vragen/' }];
const all = await getCollection('faq');
const topics = [
  { id: 'start', title: 'Beginnen' },
  { id: 'lekce', title: 'Proefrit & lessen' },
  { id: 'zdravi', title: 'Gezondheid' },
  { id: 'steps', title: 'Sportsteps' },
] as const;
---
<BaseLayout
  title="Veelgestelde vragen over sportsteppen"
  description="Antwoorden op de meest gestelde vragen: moet ik fit zijn? Is steppen goed voor je knieën? Wat neem ik mee naar een proefrit? Welke step kies ik?"
  jsonLd={[breadcrumbSchema(crumbs), faqSchema(all.map((f) => f.data))]}
>
  <PageHero eyebrow="FAQ" title="Veelgestelde vragen" lead="Staat je vraag er niet tussen? Stuur me een bericht – ik help je graag." crumbs={crumbs} />
  <section class="section" style="padding-top:0">
    <div class="container faq-page">
      {topics.map((topic) => (
        <div class="faq-group" id={topic.id}>
          <h2>{topic.title}</h2>
          <FaqList items={all.filter((f) => f.data.topic === topic.id).map((f) => f.data)} />
        </div>
      ))}
    </div>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  .faq-page {
    max-width: 860px;
  }
  .faq-group + .faq-group {
    margin-top: 48px;
  }
  .faq-group h2 {
    font-size: 1.6rem;
  }
</style>
