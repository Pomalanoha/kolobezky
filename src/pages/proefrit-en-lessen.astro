---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import imgDuinen from '../assets/photos/sportsteppen-in-de-duinen.jpg';
import Icon from '../components/Icon.astro';
import TryBuyJoin from '../components/TryBuyJoin.astro';
import LessonTimeline from '../components/LessonTimeline.astro';
import Testimonials from '../components/Testimonials.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, bookingHref, voucher } from '../config';
import { t } from '../i18n/ui';
import { breadcrumbSchema, businessId } from '../lib/schema';

const crumbs = [{ name: 'Proefrit & lessen', href: '/proefrit-en-lessen/' }];
const faq = (await getCollection('faq')).filter((f) => f.data.topic === 'lekce').map((f) => f.data);

// Nabídka služeb. price: 0 = zdarma, null = zobrazí se „op aanvraag“; priceNote = doplňující řádek pod cenou.
const offers = [
  {
    id: 'proefrit',
    title: 'Proefrit',
    tagline: 'Try – kennismaken met steppen',
    duration: '± 45 min',
    price: 0 as number | null,
    priceNote: 'step en helm te leen',
    highlight: true,
    features: ['uitleg over de step en de juiste houding', 'rustig oefenen in het park', 'verschillende steps uitproberen', 'persoonlijk advies over de modelkeuze'],
  },
  {
    id: 'prive',
    title: 'Privéles of training',
    tagline: 'Individueel, afgestemd op jouw doelen',
    duration: '± 75 min',
    price: 45,
    priceNote: 'incl. step en helm · € 30 met je eigen step',
    highlight: false,
    features: ['de juiste houding en techniek', 'warming-up en cooling-down', 'conditietraining in de natuur', 'aanmoediging, coaching en advies over voeding'],
  },
  {
    id: 'workshop',
    title: 'Workshop sportsteppen',
    tagline: 'Een tocht vol bewegen, natuur en tips',
    duration: '± 2–3 uur',
    price: 65,
    priceNote: 'met je eigen step',
    highlight: false,
    features: ['houding en techniek onderweg', 'een tocht, bijv. door de duinen naar zee', 'mindfulness en een gezonde leefstijl', 'picknick met voedingstips en materiaal om mee te nemen'],
  },
  {
    id: 'groepstraining',
    title: 'Groepstraining',
    tagline: 'Samen trainen met de club',
    duration: '± 75 min',
    price: 0,
    priceNote: 'voor clubleden · € 25 voor anderen, met je eigen step',
    highlight: false,
    features: ['training in een kleine groep', 'techniek en conditie', 'routes rond Haarlem en in de duinen', 'gezellig samen buiten bewegen'],
  },
];

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: offers.map((o, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: o.title,
      description: o.features.join(', '),
      provider: { '@id': businessId },
      areaServed: site.areaServed,
      ...(o.price !== null ? { offers: { '@type': 'Offer', price: o.price, priceCurrency: 'EUR' } } : {}),
    },
  })),
};
---
<BaseLayout
  title="Proefrit & lessen sportsteppen in Haarlem"
  description="Probeer sportsteppen onder begeleiding van Linda: een proefrit, een workshop in de duinen of een privéles rond Haarlem. Bij de proefrit en privéles krijg je een step te leen."
  jsonLd={[breadcrumbSchema(crumbs), offerSchema]}
>
  <PageHero eyebrow="Try, Buy & Join" title="Eerst proberen. Dan zelf steppen. En samen op pad!" lead="Voordat je besluit een step aan te schaffen, raad ik je aan eerst te proberen welk type bij je past. Tijdens een proefrit leer je ook hoe je veilig en efficiënt stept – en of dit jouw manier van bewegen is." crumbs={crumbs}>
    <div class="btn-row">
      <a class="btn btn--primary" href={bookingHref}>{t('cta.book')}</a>
      <a class="btn btn--secondary" href="#nabidka">Aanbod en prijzen</a>
    </div>
    <Photo slot="aside" src={imgDuinen} alt="Deelneemster op een sportstep tijdens een workshop in de duinen" ratio="4 / 3" priority />
  </PageHero>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Zo verloopt je eerste les</span>
        <h2>Geen stress. Stap voor stap.</h2>
        <p class="lead">Je hoeft niets te kunnen en geen eigen step te hebben. Zo ziet je eerste rit met Linda eruit.</p>
      </div>
      <LessonTimeline />
      <p class="tl-cta"><a class="btn btn--primary" href={bookingHref}>{t('cta.book')}</a></p>
    </div>
  </section>

  <section class="section" id="nabidka">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Aanbod</span>
        <h2>Kies hoe je begint</h2>
        <p class="lead">Bij de proefrit en de privéles krijg je een step en helm van mij te leen. Voor workshops en groepstrainingen heb je een eigen step nodig. Verder alleen sportkleding en een goed humeur!</p>
      </div>
      <div class="offers">
        {offers.map((o) => (
          <article class:list={['offer', 'card', { 'offer--highlight': o.highlight }]} id={o.id}>
            {o.highlight && <span class="offer__flag">Beste start</span>}
            <h3>{o.title}</h3>
            <p class="offer__tagline">{o.tagline}</p>
            <p class="offer__price">
              {o.price === 0 ? 'Gratis' : o.price ? `€ ${o.price}` : 'prijs op aanvraag'}
              <span>{o.duration}{o.priceNote && ` · ${o.priceNote}`}</span>
            </p>
            <ul class="checklist">
              {o.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class:list={['btn', o.highlight ? 'btn--primary' : 'btn--secondary']} href={site.bookingUrl || `/contact/?onderwerp=${o.id}`}>
              {o.highlight ? t('cta.book') : 'Ik heb interesse'}
            </a>
          </article>
        ))}
        <article class="offer card offer--gift" id="poukaz">
          <span class="offer__flag offer__flag--gift">Cadeautip</span>
          <h3>Cadeaubon</h3>
          <p class="offer__tagline">Geef een belevenis op de step cadeau</p>
          <p class="offer__price">
            v.a. € {Math.min(...voucher.amounts)}
            <span>{voucher.validityMonths / 12} jaar geldig</span>
          </p>
          <ul class="checklist">
            <li>voor een workshop, privéles of training</li>
            <li>de ontvanger kiest zelf een datum</li>
            <li>per e-mail, om te printen</li>
          </ul>
          <a class="btn btn--secondary" href="/cadeaubon/">Cadeaubon geven</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Zo werkt het</span>
        <h2>Een sportstep kopen is pas het begin</h2>
        <p class="lead">Koop je na de proefrit een step via onze webshop? Dan krijg je:</p>
      </div>
      <TryBuyJoin />
      <ul class="perks">
        <li><Icon name="wrench" /> persoonlijk afsteladvies</li>
        <li><Icon name="check" /> uitleg over onderhoud</li>
        <li><Icon name="users" /> gratis clubritten en trainingen</li>
      </ul>
      <a class="btn btn--primary" href="/sportsteps/">Bekijk de steps <Icon name="arrow" size={18} /></a>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Ervaringen</span>
        <h2>Zo gaat het in de praktijk</h2>
      </div>
      <Testimonials limit={3} />
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head">
        <span class="eyebrow">Praktisch</span>
        <h2>Veelgestelde vragen over de lessen</h2>
      </div>
      <FaqList items={faq} />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container extras">
      <a class="extra" href="/groepen/">
        <Icon name="users" size={26} />
        <span><strong>Met een groep?</strong>Bedrijfsuitjes, vrijgezellenfeesten, verjaardagen – ik stel een programma op maat samen.</span>
        <Icon name="arrow" size={20} />
      </a>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .tl-cta {
    text-align: center;
    margin: 36px 0 0;
  }
  .extras {
    display: grid;
    gap: 16px;
  }
  .offers {
    display: grid;
    gap: clamp(16px, 2.5vw, 24px);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }
  .offer--gift {
    grid-column: 1 / -1;
    background: linear-gradient(160deg, #fff6ef, #ffe8da);
    border-color: #f6c3a8;
  }
  /* Poukaz jako široká karta pod nabídkou */
  @media (min-width: 900px) {
    .offer.offer--gift {
      display: grid;
      grid-template-columns: auto auto 1fr auto;
      column-gap: clamp(24px, 3vw, 48px);
      align-items: center;
    }
    .offer--gift h3 {
      grid-area: 1 / 1;
      align-self: end;
    }
    .offer--gift .offer__tagline {
      grid-area: 2 / 1;
      align-self: start;
      margin: 0;
    }
    .offer--gift .offer__price {
      grid-area: 1 / 2 / 3 / 3;
      margin: 0;
      padding: 0 0 0 clamp(24px, 3vw, 48px);
      border-bottom: 0;
      border-left: 1px solid #f6c3a8;
    }
    .offer--gift .checklist {
      grid-area: 1 / 3 / 3 / 4;
      margin: 0;
    }
    .offer--gift .btn {
      grid-area: 1 / 4 / 3 / 5;
      margin: 0;
    }
  }
  .offer__flag--gift {
    background: var(--forest-900);
    color: var(--white);
  }
  .extra {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 24px;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--border);
    color: var(--forest-900);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .extra:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .extra > :global(svg:first-child) {
    flex: none;
    color: var(--orange-600);
  }
  .extra span {
    flex: 1;
    display: flex;
    flex-direction: column;
    color: var(--muted);
  }
  .extra strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--forest-900);
  }
  .extra--gift {
    background: var(--orange-100);
    border-color: #f6c3a8;
  }
  .narrow {
    max-width: 860px;
  }
  .offer {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .offer h3 {
    margin-bottom: 4px;
  }
  .offer__tagline {
    color: var(--muted);
    margin-bottom: 16px;
  }
  .offer__price {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--forest-900);
    display: flex;
    flex-direction: column;
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }
  .offer__price span {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
  }
  .offer .btn {
    margin-top: auto;
  }
  .offer--highlight {
    border: 2px solid var(--orange-500);
    box-shadow: var(--shadow);
  }
  .offer__flag {
    position: absolute;
    top: -13px;
    left: 24px;
    background: var(--orange-500);
    color: var(--accent-ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35em 0.9em;
    border-radius: 999px;
  }
  .perks {
    list-style: none;
    padding: 0;
    margin: 32px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    color: var(--sand-100);
    font-weight: 550;
  }
  .perks li {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
  .perks :global(svg) {
    color: var(--orange-500);
  }
</style>
