---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import imgGroep from '../assets/photos/clubrit-groep.jpg';
import imgDuinen from '../assets/photos/sportsteppen-in-de-duinen.jpg';
import { site } from '../config';
import { breadcrumbSchema, businessId } from '../lib/schema';

const crumbs = [{ name: 'Groepsuitjes', href: '/groepen/' }];
const types = [
  { icon: 'users', title: 'Bedrijfsuitje', text: 'Teambuilding in de buitenlucht die iedereen leuk vindt – van sporters tot collega’s die normaal niet sporten.', bg: '#e6eef7', fg: '#1e40af' },
  { icon: 'heart', title: 'Vrijgezellenfeest', text: 'Een originele belevenis voor de bruid of bruidegom en een groep vrienden. Lachen gegarandeerd.', bg: '#ffe6d9', fg: '#c2410c' },
  { icon: 'star', title: 'Verjaardagen en feestjes', text: 'Een cadeau om nooit te vergeten – samen met vrienden op pad, bijvoorbeeld door de duinen naar zee.', bg: '#f4ead6', fg: '#8a6116' },
  { icon: 'leaf', title: 'Clubs en verenigingen', text: 'Sportclubs, hardloopgroepen, seniorenverenigingen – probeer samen eens iets nieuws.', bg: '#dcefe5', fg: '#1d5a46' },
] as const;
const program = [
  { title: 'Welkom en uitleg', text: 'We stellen de steps af en ik laat de basistechniek zien – iedereen kan het.' },
  { title: 'Rustig inrijden', text: 'Even oefenen in het park, zodat iedereen zich zeker voelt.' },
  { title: 'Samen op pad', text: 'Een route die past bij de groep – park, bos of door de duinen naar het strand.' },
  { title: 'Afsluiting', text: 'Rekken en strekken en samen nog even napraten – in overleg.' },
];
const eventTypes = ['Bedrijfsuitje / teambuilding', 'Vrijgezellenfeest', 'Verjaardag / feest', 'Club / vereniging', 'Familie-uitje', 'Anders'];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Groepsuitjes op sportsteps',
  serviceType: 'Groepsuitje / bedrijfsuitje',
  provider: { '@id': businessId },
  areaServed: site.areaServed,
};
---
<BaseLayout
  title="Groepsuitje steppen – bedrijfsuitje, vrijgezellenfeest of verjaardag"
  description="Sportsteppen met een groep rond Haarlem: bedrijfsuitjes en teambuilding, vrijgezellenfeesten, verjaardagen en clubs. Route en programma op maat geregeld."
  jsonLd={[breadcrumbSchema(crumbs), serviceSchema]}
>
  <PageHero eyebrow="Groepsuitjes" title="Een stepbelevenis voor de hele groep" lead="Een bedrijfsuitje, vrijgezellenfeest of verjaardag – samen op pad op sportsteps. Ik zorg voor de route en het programma, en ervoor dat iedereen het naar zijn zin heeft." crumbs={crumbs}>
    <div class="btn-row">
      <a class="btn btn--primary" href="#poptavka">Vrijblijvende aanvraag</a>
      <a class="btn btn--secondary" href={site.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a>
    </div>
    <Photo slot="aside" src={imgGroep} alt="Groepsrit op sportsteps" ratio="4 / 3" position="50% 65%" priority />
  </PageHero>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="types">
        {types.map((t) => (
          <article class="type" style={`--bg:${t.bg};--fg:${t.fg}`}>
            <span class="type__icon"><Icon name={t.icon} size={24} /></span>
            <h2>{t.title}</h2>
            <p>{t.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container split">
      <div>
        <span class="eyebrow">Zo verloopt het</span>
        <h2>Een programma op maat van je groep</h2>
        <ol class="prog">
          {program.map((p, i) => (
            <li><span class="prog__no">{i + 1}</span><div><strong>{p.title}</strong><p>{p.text}</p></div></li>
          ))}
        </ol>
        <ul class="checklist">
          <li>voor groepen met een eigen step – ik heb er voorlopig 2 te leen</li>
          <li>neem je eigen helm mee, of koop er een via de webshop</li>
          <li>route en tempo afgestemd op de groep</li>
          <li>duur ca. 2–3 uur (in overleg)</li>
          <li>ook tochten verder weg – zelfs een steptocht door Europa, waar we samen voor trainen</li>
        </ul>
        <Todo>Doplnit s Lindou: cena za osobu / skupinu a možnost spojit s občerstvením.</Todo>
      </div>
      <Photo src={imgDuinen} alt="Steptocht door de duinen" ratio="4 / 5" />
    </div>
  </section>

  <section class="section" id="poptavka">
    <div class="container inquiry">
      <div>
        <span class="eyebrow">Vrijblijvende aanvraag</span>
        <h2>Vertel me wat jullie van plan zijn</h2>
        <p class="lead">Je ontvangt van mij een voorstel voor het programma, de route en de prijs. Je zit nergens aan vast.</p>
        <p>Liever meteen? <a href={site.whatsapp} target="_blank" rel="noopener">Stuur een WhatsApp</a> of bel <a href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <form class="card form" method="POST" action="/api/contact/" novalidate data-group-form>
        <input type="hidden" name="onderwerp" value="skupina" />
        <p class="visually-hidden"><label>Niet invullen: <input name="website" tabindex="-1" autocomplete="off" /></label></p>
        <div class="field">
          <label for="soort">Soort uitje</label>
          <select id="soort" name="soort">
            {eventTypes.map((e) => <option>{e}</option>)}
          </select>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="groep_grootte">Aantal personen</label>
            <input id="groep_grootte" name="groep_grootte" type="number" min="2" max="60" inputmode="numeric" placeholder="bijv. 8" />
          </div>
          <div class="field">
            <label for="datum">Voorkeursdatum</label>
            <input id="datum" name="datum" placeholder="bijv. zaterdag 14 juni, ’s middags" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="naam">Voor- en achternaam</label>
            <input id="naam" name="naam" autocomplete="name" required />
            <p class="field__error" data-error-for="naam"></p>
          </div>
          <div class="field">
            <label for="telefoon">Telefoon <span class="opt">(optioneel)</span></label>
            <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" />
            <p class="field__error" data-error-for="telefoon"></p>
          </div>
        </div>
        <div class="field">
          <label for="email">E-mailadres</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
          <p class="field__error" data-error-for="email"></p>
        </div>
        <div class="field">
          <label for="bericht">Verder nog iets? <span class="opt">(optioneel)</span></label>
          <textarea id="bericht" name="bericht" rows="3" placeholder="Bijvoorbeeld het niveau van de groep, de locatie, het budget…"></textarea>
        </div>
        <label class="consent">
          <input type="checkbox" name="toestemming" required />
          <span>Ik ga akkoord met de verwerking van mijn gegevens volgens het <a href="/privacybeleid/">privacybeleid</a>.</span>
        </label>
        <p class="field__error" data-error-for="toestemming"></p>
        <button class="btn btn--primary" type="submit">Aanvraag versturen <Icon name="arrow" size={18} /></button>
        <p class="form-error" data-form-error role="alert"></p>
      </form>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container gift">
      <div>
        <span class="eyebrow">Cadeautip</span>
        <h2>Geen heel uitje? Geef een cadeaubon.</h2>
        <p class="lead">Een cadeaubon voor een workshop of privéles – de ontvanger kiest zelf de datum.</p>
      </div>
      <a class="btn btn--primary" href="/cadeaubon/">Cadeaubon <Icon name="arrow" size={18} /></a>
    </div>
  </section>
</BaseLayout>

<script>
  import { enhanceForm } from '../scripts/ajaxForm';
  const form = document.querySelector<HTMLFormElement>('[data-group-form]');
  if (form) enhanceForm(form);
</script>

<style>
  .types {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }
  .type {
    background: var(--bg);
    border-radius: var(--radius-lg);
    padding: 24px;
  }
  .type__icon {
    width: 50px;
    height: 50px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: var(--white);
    color: var(--fg);
    box-shadow: var(--shadow-sm);
  }
  .type h2 {
    font-size: 1.25rem;
    margin: 14px 0 6px;
  }
  .type p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .prog {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .prog li {
    display: flex;
    gap: 14px;
  }
  .prog__no {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--orange-500);
    color: var(--accent-ink);
    font-weight: 750;
  }
  .prog strong {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--forest-900);
  }
  .prog p {
    margin: 2px 0 0;
    color: var(--muted);
  }
  .inquiry {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .inquiry {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
  .form {
    display: grid;
    gap: 14px;
  }
  .field {
    display: grid;
    gap: 6px;
  }
  .field-row {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--forest-900);
  }
  .opt {
    font-weight: 400;
    color: var(--muted);
  }
  input:not([type='checkbox']),
  select,
  textarea {
    font: inherit;
    width: 100%;
    padding: 0.75em 0.9em;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--sand-50);
    color: var(--ink);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--forest-500);
    box-shadow: 0 0 0 4px var(--forest-100);
  }
  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .consent input {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    flex: none;
    accent-color: var(--forest-700);
  }
  .field__error,
  .form-error {
    margin: 0;
    color: #b42318;
    font-size: 0.88rem;
    font-weight: 500;
  }
  .field__error:empty,
  .form-error:empty {
    display: none;
  }
  .form .btn {
    justify-self: start;
  }
  .gift {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .gift .lead {
    margin: 0;
  }
</style>
