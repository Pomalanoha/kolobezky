---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import imgGroep from '../assets/photos/clubrit-groep.jpg';
import imgDuinen from '../assets/photos/sportsteppen-in-de-duinen.jpg';
import Icon from '../components/Icon.astro';
import Testimonials from '../components/Testimonials.astro';
import Todo from '../components/Todo.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [{ name: 'Club', href: '/club/' }];
const points = [
  { icon: 'users', title: 'Samen steppen', text: 'Regelmatige clubritten rond Hoofddorp, Haarlem en in de duinen.' },
  { icon: 'bolt', title: 'Trainingen', text: 'Aangekondigde trainingen in techniek en conditie voor elk niveau.' },
  { icon: 'route', title: 'Nieuwe routes', text: 'Ontdek plekken waar je in je eentje niet snel naartoe zou gaan.' },
  { icon: 'heart', title: 'Gezelligheid', text: 'Je ontmoet andere sportsteppers, deelt ervaringen en motiveert elkaar.' },
] as const;
---
<BaseLayout
  title="Stepclub – samen sportsteppen in de Haarlemmermeer"
  description="Kickbike Club Hille: clubritten en trainingen sportsteppen rond Hoofddorp, Haarlem en in de duinen. Gratis voor klanten."
  jsonLd={breadcrumbSchema(crumbs)}
>
  <PageHero eyebrow="Kickbike Club Hille" title="Jouw step. Jouw tempo. Jouw club." lead="Een sportstep kopen is pas het begin. Als klant doe je gratis mee aan clubritten en aangekondigde trainingen – zo ontmoet je andere sportsteppers, doe je ervaring op en ontdek je nieuwe routes." crumbs={crumbs}>
    <Photo slot="aside" src={imgGroep} alt="Clubrit op sportsteps" ratio="4 / 5" position="50% 60%" priority />
  </PageHero>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="grid grid--4">
        {points.map((p) => (
          <div class="card point">
            <div class="point__icon"><Icon name={p.icon} /></div>
            <h2>{p.title}</h2>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container split">
      <div>
        <span class="eyebrow">Meedoen</span>
        <h2>Wanneer en waar we steppen</h2>
        <Todo>Doplnit: jak často jsou klubové jízdy (např. 1× týdně / 2× měsíčně), den a čas, místo srazu, úrovně, jak se přihlásit (WhatsApp skupina?). Zvážit i placené členství pro ty, kdo koloběžku koupili jinde.</Todo>
        <ul class="checklist">
          <li>clubritten en aangekondigde trainingen zijn gratis voor klanten van de webshop</li>
          <li>je ontmoet andere sportsteppers en doet ervaring op</li>
          <li>je ontdekt nieuwe routes in de omgeving</li>
        </ul>
        <a class="btn btn--primary" href="/contact/?onderwerp=club">Ik wil meedoen</a>
      </div>
      <Photo src={imgDuinen} alt="Sportsteppen in de duinen" ratio="4 / 3" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Ze sedla</span>
        <h2>Ervaringen van leden en klanten</h2>
      </div>
      <Testimonials />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .point h2 {
    font-size: 1.25rem;
    margin: 14px 0 6px;
  }
  .point p {
    margin: 0;
    color: var(--muted);
  }
  .point__icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--orange-100);
    color: var(--orange-600);
  }
</style>
