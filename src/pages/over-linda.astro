---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import imgLinda from '../assets/photos/linda-met-crussis-cobra.jpg';
import Todo from '../components/Todo.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config';
import { breadcrumbSchema, businessId } from '../lib/schema';

const crumbs = [{ name: 'Over Linda', href: '/over-linda/' }];
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.owner,
  jobTitle: 'Sportstep-coach',
  worksFor: { '@id': businessId },
  knowsLanguage: ['nl', 'cs'],
};
---
<BaseLayout
  title="Over Linda – sportstep-coach in Haarlem"
  description="Linda Pokorná nam het sportsteppen mee van Tsjechië naar Nederland. Haar missie: Nederland op de step krijgen – leuk, gezond en op elke leeftijd."
  jsonLd={[breadcrumbSchema(crumbs), personSchema]}
>
  <PageHero eyebrow="Wie je begeleidt" title="Hoi, ik ben Linda" lead="In Tsjechië geboren, in Nederland getogen. Na een lange tijd weer in Tsjechië gewoond te hebben, ben ik terug in Nederland – samen met mijn step." crumbs={crumbs}>
    <Photo slot="aside" src={imgLinda} alt="Linda Pokorná met haar Crussis Cobra" ratio="4 / 3" priority />
  </PageHero>

  <section class="section" style="padding-top:0">
    <div class="container story">
      <div class="prose">
        <h2>Hoe ik bij het steppen kwam</h2>
        <p>In Tsjechië is steppen erg populair en wint het steeds meer aan populariteit, ook onder zorgprofessionals – vanwege de vele voordelen voor de gezondheid en het potentieel bij revalidatie. Sportsteppen is oorspronkelijk ontstaan uit de behoefte van professionele biatleten om ook in de zomer te trainen.</p>
        <p>Mijn step heb ik uiteraard meegenomen naar Nederland. Al snel ontdekte ik dat Nederland een stepland bij uitstek is, maar dat het steppen hier in de vergetelheid is geraakt. Ik heb besloten om daar verandering in te brengen. :)</p>
        <p>De techniek van het sportsteppen heb ik vooral door veel oefenen geleerd, met hulp en instructies van koplopers op stepgebied in Tsjechië. Zelf rijd ik al jaren op mijn Crussis Cobra en het steppen is een steeds grotere passie geworden.</p>

        <h2>Mijn missie</h2>
        <p>Mijn streven is om op een leuke manier gezond en fit te blijven tot op hoge leeftijd – en anderen daarbij te helpen. Mijn motto:</p>
        <blockquote><p>„I will not let age change me, I will change the way I age.”</p></blockquote>
        <p><strong>De missie: Nederland op de step krijgen.</strong> Tijd voor een nieuwe uitdaging? Tot ziens op de step!</p>
        <p>— Linda</p>
      </div>
      <aside class="card quals">
        <h3>Ervaring & opleiding</h3>
        <ul class="checklist">
          <li>Op de step sinds mijn zesde</li>
          <li>Zo'n 60 km per week op de step</li>
          <li>Instructie door koplopers op stepgebied in Tsjechië</li>
          <li>Opleiding verpleegkunde, incl. EHBO</li>
          <li>Holistische leefstijl & voedingsbegeleiding</li>
        </ul>
        <Todo>Dodat další fotky Lindy (les, technika, s klienty) pro galerii.</Todo>
        <h3>Talen</h3>
        <p>Nederlands · Tsjechisch</p>
      </aside>
    </div>
  </section>

  <CtaBand title="Tijd voor een nieuwe uitdaging?" text="Boek een proefrit – tot ziens op de step!" />
</BaseLayout>

<style>
  .story {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 900px) {
    .story {
      grid-template-columns: 1.5fr 1fr;
      align-items: start;
    }
    .quals {
      position: sticky;
      top: 96px;
    }
  }
  .quals h3 {
    font-size: 1.15rem;
  }
  .quals h3 + p {
    margin: 0;
  }
</style>
