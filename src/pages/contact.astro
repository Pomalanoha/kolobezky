---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import { site } from '../config';
import { t } from '../i18n/ui';
import { breadcrumbSchema, businessSchema } from '../lib/schema';
import { SUBJECTS } from '../lib/subjects';

const crumbs = [{ name: 'Contact', href: '/contact/' }];
const subjects = Object.entries(SUBJECTS).map(([value, label]) => ({ value, label }));
---
<BaseLayout
  title="Contact & boeken – sportsteppen Hoofddorp"
  description="Boek een proefrit of stel je vraag over sportsteps. Neem contact op met Linda via WhatsApp, telefoon of e-mail. Kickbike Club Hille, Hoofddorp."
  jsonLd={[breadcrumbSchema(crumbs), businessSchema()]}
>
  <PageHero eyebrow="Contact" title="Meer weten of boeken?" lead="Vul het korte formulier in of stuur me direct een WhatsApp-bericht. Ik neem zo snel mogelijk contact met je op." crumbs={crumbs} />

  <section class="section" style="padding-top:0">
    <div class="container contact">
      <form class="card form" method="POST" action="/api/contact/" novalidate data-contact-form>
        <p class="visually-hidden"><label>Niet invullen: <input name="website" tabindex="-1" autocomplete="off" /></label></p>

        <div class="field">
          <label for="onderwerp">Waar heb je interesse in?</label>
          <select id="onderwerp" name="onderwerp" required>
            {subjects.map((s) => <option value={s.value}>{s.label}</option>)}
          </select>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="naam">Voor- en achternaam</label>
            <input id="naam" name="naam" type="text" autocomplete="name" required />
            <p class="field__error" data-error-for="naam"></p>
          </div>
          <div class="field">
            <label for="telefoon">Telefoon <span class="opt">(optioneel)</span></label>
            <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" />
            <p class="field__error" data-error-for="telefoon"></p>
          </div>
        </div>
        <div class="field">
          <label for="email">E-mailadres</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
          <p class="field__error" data-error-for="email"></p>
        </div>
        <div class="field">
          <label for="bericht">Bericht</label>
          <textarea id="bericht" name="bericht" rows="5" placeholder="Bijvoorbeeld wanneer het je uitkomt, met hoeveel personen je komt of eventuele lichamelijke beperkingen…"></textarea>
        </div>
        <label class="consent">
          <input type="checkbox" name="toestemming" required />
          <span>Ik ga akkoord met de verwerking van mijn gegevens volgens het <a href="/privacybeleid/">privacybeleid</a>.</span>
        </label>
        <p class="field__error" data-error-for="toestemming"></p>
        <button class="btn btn--primary" type="submit">Bericht versturen <Icon name="arrow" size={18} /></button>
        <p class="form-error" data-form-error role="alert"></p>
      </form>

      <aside class="contact__aside">
        <a class="card contact__wa" href={site.whatsapp} target="_blank" rel="noopener">
          <span class="contact__wa-icon"><Icon name="whatsapp" size={28} /></span>
          <span>
            <strong>{t('cta.whatsapp')}</strong>
            <span>De snelste weg naar een afspraak</span>
          </span>
        </a>
        <div class="card">
          <ul class="contact__list">
            <li><Icon name="phone" /><a href={site.phoneHref}>{site.phone}</a></li>
            <li><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><Icon name="pin" /><span>{site.city} en omgeving<br /><small>{site.areaServed.join(', ')}</small></span></li>
          </ul>
        </div>
        <div class="card">
          <h2>Waar spreken we af?</h2>
          <p>De startplek spreken we per afspraak af – meestal in Hoofddorp (Haarlemmermeerse Bos), bij tochten door de duinen in Zandvoort of omgeving. <a href="/routes/">Waar we steppen →</a></p>
          <Todo>Doplnit konkrétní místa srazu, příp. vložit mapu (OpenStreetMap kvůli GDPR).</Todo>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import { enhanceForm } from '../scripts/ajaxForm';
  const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (contactForm) enhanceForm(contactForm);

  // Předvyplní „Co tě zajímá?“ a zprávu podle odkazu (např. /contact/?onderwerp=sportstep&model=Cobra).
  const params = new URLSearchParams(location.search);
  const subject = params.get('onderwerp');
  const model = params.get('model');
  const select = document.getElementById('onderwerp') as HTMLSelectElement | null;
  if (select && subject && [...select.options].some((o) => o.value === subject)) select.value = subject;
  const msg = document.getElementById('bericht') as HTMLTextAreaElement | null;
  if (msg && model) msg.value = `Ik heb interesse in: ${model}\n`;
</script>

<style>
  .contact {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 900px) {
    .contact {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }
  }
  .form {
    display: grid;
    gap: 18px;
  }
  .field {
    display: grid;
    gap: 6px;
  }
  .field-row {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 640px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--forest-900);
  }
  .opt {
    font-weight: 400;
    color: var(--muted);
  }
  input,
  select,
  textarea {
    font: inherit;
    width: 100%;
    padding: 0.8em 1em;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--sand-50);
    color: var(--ink);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--forest-500);
    box-shadow: 0 0 0 4px var(--forest-100);
  }
  .field__error,
  .form-error {
    margin: 0;
    color: #b42318;
    font-size: 0.88rem;
    font-weight: 500;
  }
  .field__error:empty,
  .form-error:empty {
    display: none;
  }
  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-weight: 400;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .consent input {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    flex: none;
  }
  .form .btn {
    justify-self: start;
  }
  .contact__aside {
    display: grid;
    gap: 16px;
  }
  .contact__aside h2 {
    font-size: 1.3rem;
  }
  .contact__wa {
    display: flex;
    gap: 16px;
    align-items: center;
    text-decoration: none;
    color: inherit;
    background: #e9fbef;
    border-color: #bfeccc;
  }
  .contact__wa strong {
    display: block;
    color: #0b5a2b;
    font-size: 1.1rem;
  }
  .contact__wa span span {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .contact__wa-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #062d16;
    display: grid;
    place-items: center;
    flex: none;
  }
  .contact__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .contact__list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .contact__list :global(svg) {
    color: var(--orange-600);
    flex: none;
    margin-top: 2px;
  }
  .contact__list small {
    color: var(--muted);
  }
</style>
