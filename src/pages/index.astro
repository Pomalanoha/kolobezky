---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import imgLinda from '../assets/photos/linda-met-crussis-cobra.jpg';
import Icon from '../components/Icon.astro';
import TryBuyJoin from '../components/TryBuyJoin.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Marquee from '../components/home/Marquee.astro';
import ModelPicker from '../components/home/ModelPicker.astro';
import Bento from '../components/home/Bento.astro';
import RouteMap from '../components/home/RouteMap.astro';
import ExtrasCards from '../components/ExtrasCards.astro';
import Testimonials from '../components/Testimonials.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config';
import { businessSchema } from '../lib/schema';

const faq = (await getCollection('faq')).filter((f) => ['fit-zijn', 'eigen-step', 'knieen', 'welk-model'].includes(f.id));

const pains = [
  'de sportschool past niet bij je',
  'hardlopen is het net niet',
  'je wilt conditie opbouwen of behouden',
  'je bent aan het revalideren',
  'je houdt van bewegen in de buitenlucht',
];

const benefits = [
  { icon: 'heart', title: 'Betere conditie', text: 'Duurtraining voor hart en longen – net als hardlopen of fietsen.', bg: '#ffe6d9', fg: '#c2410c' },
  { icon: 'users', title: 'Je hele lichaam', text: 'Benen, billen, core en armen. Je hele lichaam wordt sterker.', bg: '#e6eef7', fg: '#1e40af' },
  { icon: 'joint', title: 'Gewrichtsvriendelijk', text: 'Geen schokken zoals bij hardlopen. Fijn voor knieën, heupen en rug.', bg: '#dcefe5', fg: '#1d5a46' },
  { icon: 'leaf', title: 'Buiten in de natuur', text: 'Park, bos, duinen, strand – in plaats van een sportschool met airco.', bg: '#f4ead6', fg: '#8a6116' },
] as const;
---
<BaseLayout
  title="Sportsteppen in Haarlem – proefrit, lessen & sportsteps | Kickbike Club Hille"
  fullTitle
  description="Sportsteppen in Haarlem en omgeving (Heemstede, Zandvoort, de duinen). Probeer een sportstep tijdens een gratis proefrit met Linda, kies je Crussis-model en step mee met de club."
  jsonLd={businessSchema()}
>
  <HomeHero />

  <!-- POZNÁVÁŠ SE? -->
  <section class="section section--tint intro">
    <div class="container split">
      <div>
        <span class="eyebrow">Herken je dit?</span>
        <h2>Op zoek naar een workout die je leuk vindt?</h2>
        <ul class="checklist">
          {pains.map((p) => <li>{p}</li>)}
        </ul>
        <p class="lead">Dan is <a href="/sportsteppen/">sportsteppen</a> een verrassend goede oplossing. Je hoeft niet fit te zijn om te beginnen – je begint om fitter te worden.</p>
      </div>
      <div class="benefits">
        {benefits.map((b, i) => (
          <div class="benefit" style={`--bg:${b.bg};--fg:${b.fg};--tilt:${i % 2 ? 1.2 : -1.2}deg`}>
            <div class="benefit__icon"><Icon name={b.icon} size={26} /></div>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Marquee />

  <!-- KOLOBĚŽKY -->
  <section class="section">
    <div class="container">
      <div class="section-head head-row">
        <div>
          <span class="eyebrow">Crussis sportsteps</span>
          <h2>Drie stijlen, één en al rijplezier</h2>
          <p class="lead">Kwalitatieve sportsteps van een Tsjechische fabrikant. Ik adviseer je welke bij je past – en stel hem op maat af.</p>
        </div>
        <a href="/sportsteps/" class="btn btn--secondary">Alle modellen</a>
      </div>
      <ModelPicker />
    </div>
  </section>

  <!-- GALERIE -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Zo ziet het eruit</span>
        <h2>Frisse lucht, wind door je haren en gezelligheid</h2>
      </div>
      <Bento />
    </div>
  </section>

  <!-- TRY BUY JOIN -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Try, Buy &amp; Join</span>
        <h2>Eerst proberen. Dan zelf steppen. En samen op pad!</h2>
        <p class="lead">Geen aankoop op goed geluk. Je probeert de step eerst uit met persoonlijke begeleiding – en na de aankoop sta je er niet alleen voor.</p>
      </div>
      <TryBuyJoin />
      <div class="btn-row" style="margin-top:32px">
        <a class="btn btn--primary" href="/proefrit-en-lessen/">Proefrit & lessen <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- KDE JEZDÍME -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Waar we steppen</span>
        <h2>Van het park tot aan zee</h2>
        <p class="lead">We beginnen rustig in het park. Zit de techniek goed, dan gaan we voor langere routes – bijvoorbeeld door de duinen naar het strand van Zandvoort.</p>
      </div>
      <RouteMap />
    </div>
  </section>

  <!-- REFERENCE -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Ervaringen</span>
        <h2>Wat anderen ervan vinden</h2>
      </div>
      <Testimonials featuredOnly limit={3} />
      <p style="margin-top:24px"><a href="/ervaringen/">Alle ervaringen →</a></p>
    </div>
  </section>

  <!-- O LINDĚ -->
  <section class="section">
    <div class="container split">
      <Photo src={imgLinda} alt="Linda Pokorná met haar Crussis Cobra" ratio="4 / 3" />
      <div>
        <span class="eyebrow">Wie je begeleidt</span>
        <h2>Hoi, ik ben Linda</h2>
        <p class="lead">In Tsjechië geboren, in Nederland getogen. In Tsjechië is steppen een populaire sport – dus mijn step heb ik natuurlijk meegenomen.</p>
        <p>Al snel ontdekte ik dat Nederland een stepland bij uitstek is, maar dat het steppen hier in de vergetelheid is geraakt. Mijn missie: Nederland op de step krijgen – leuk, gezond en op elke leeftijd.</p>
        <p class="motto">„I will not let age change me, I will change the way I age.“</p>
        <a class="btn btn--secondary" href="/over-linda/">Mijn verhaal</a>
      </div>
    </div>
  </section>

  <!-- SKUPINY A POUKAZ -->
  <section class="section section--tint" style="padding-block:clamp(40px,6vw,72px)">
    <div class="container">
      <ExtrasCards />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-wrap">
      <div class="section-head">
        <span class="eyebrow">Veelgestelde vragen</span>
        <h2>Voordat je op pad gaat</h2>
        <p class="lead">Staat je vraag er niet tussen? <a href={site.whatsapp} target="_blank" rel="noopener">Stuur me een WhatsApp</a>.</p>
        <a href="/veelgestelde-vragen/">Alle vragen →</a>
      </div>
      <FaqList items={faq.map((f) => f.data)} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .intro {
    padding-top: clamp(24px, 4vw, 48px);
  }
  .benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .benefit {
    background: var(--bg);
    border-radius: var(--radius-lg);
    padding: clamp(18px, 2.4vw, 26px);
    transform: rotate(var(--tilt));
    transition: transform 0.25s ease;
  }
  .benefit:hover {
    transform: rotate(0deg) scale(1.03);
  }
  .benefit h3 {
    margin: 14px 0 6px;
    font-size: 1.2rem;
  }
  .benefit p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .benefit__icon {
    width: 50px;
    height: 50px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: var(--white);
    color: var(--fg);
    box-shadow: var(--shadow-sm);
  }
  @media (max-width: 420px) {
    .benefits {
      grid-template-columns: 1fr;
    }
  }
  .head-row {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }
  .head-row > div {
    max-width: 680px;
  }
  .motto {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--forest-700);
    border-left: 4px solid var(--orange-500);
    padding-left: 16px;
    margin: 24px 0 28px;
  }
  .faq-wrap {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .faq-wrap {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }
</style>
