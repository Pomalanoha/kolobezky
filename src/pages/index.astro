---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import imgLinda from '../assets/photos/linda-met-crussis-cobra.jpg';
import Icon from '../components/Icon.astro';
import TryBuyJoin from '../components/TryBuyJoin.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Marquee from '../components/home/Marquee.astro';
import ModelPicker from '../components/home/ModelPicker.astro';
import Bento from '../components/home/Bento.astro';
import RouteMap from '../components/home/RouteMap.astro';
import ExtrasCards from '../components/ExtrasCards.astro';
import Testimonials from '../components/Testimonials.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config';
import { businessSchema } from '../lib/schema';

const faq = (await getCollection('faq')).filter((f) => ['fit-zijn', 'eigen-step', 'knieen', 'welk-model'].includes(f.id));

const pains = [
  'posilovna ti nesedí',
  'běh není úplně ono',
  'chceš si vybudovat nebo udržet kondici',
  'vracíš se k pohybu po zranění',
  'rád/a se hýbeš venku',
];

const benefits = [
  { icon: 'heart', title: 'Lepší kondice', text: 'Vytrvalostní trénink pro srdce a plíce – jako běh nebo kolo.', bg: '#ffe6d9', fg: '#c2410c' },
  { icon: 'users', title: 'Celé tělo', text: 'Nohy, hýždě, střed těla i paže. Tělo se zpevní rovnoměrně.', bg: '#e6eef7', fg: '#1e40af' },
  { icon: 'joint', title: 'Šetrné ke kloubům', text: 'Žádné nárazy jako při běhu. Pro kolena, kyčle i záda.', bg: '#dcefe5', fg: '#1d5a46' },
  { icon: 'leaf', title: 'Venku v přírodě', text: 'Park, les, duny, pláž – místo klimatizované posilovny.', bg: '#f4ead6', fg: '#8a6116' },
] as const;
---
<BaseLayout
  title="Sportsteppen v Hoofddorpu – zkušební jízda & koloběžky | Kickbike Club Hille"
  fullTitle
  description="Sportsteppen v Hoofddorpu a okolí (Haarlemmermeer, Haarlem, duny). Vyzkoušej sportovní koloběžku na zkušební jízdě s Lindou, vyber si model Crussis a jezdi s klubem."
  jsonLd={businessSchema()}
>
  <HomeHero />

  <!-- POZNÁVÁŠ SE? -->
  <section class="section section--tint intro">
    <div class="container split">
      <div>
        <span class="eyebrow">Poznáváš se?</span>
        <h2>Hledáš pohyb, který tě bude bavit?</h2>
        <ul class="checklist">
          {pains.map((p) => <li>{p}</li>)}
        </ul>
        <p class="lead">Pak je <a href="/sportsteppen/">sportsteppen</a> překvapivě dobré řešení. Nemusíš být fit, abys začal/a – začínáš proto, abys fit byl/a.</p>
      </div>
      <div class="benefits">
        {benefits.map((b, i) => (
          <div class="benefit" style={`--bg:${b.bg};--fg:${b.fg};--tilt:${i % 2 ? 1.2 : -1.2}deg`}>
            <div class="benefit__icon"><Icon name={b.icon} size={26} /></div>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Marquee />

  <!-- KOLOBĚŽKY -->
  <section class="section">
    <div class="container">
      <div class="section-head head-row">
        <div>
          <span class="eyebrow">Koloběžky Crussis</span>
          <h2>Tři styly, jedna radost z jízdy</h2>
          <p class="lead">Kvalitní sportovní koloběžky českého výrobce. Poradím ti, která sedí tobě – a nastavím ji na míru.</p>
        </div>
        <a href="/sportsteps/" class="btn btn--secondary">Všechny modely</a>
      </div>
      <ModelPicker />
    </div>
  </section>

  <!-- GALERIE -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Takhle to vypadá venku</span>
        <h2>Čerstvý vzduch, vítr ve vlasech a parta</h2>
      </div>
      <Bento />
    </div>
  </section>

  <!-- TRY BUY JOIN -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Try, Buy &amp; Join</span>
        <h2>Nejdřív vyzkoušej. Pak jezdi sám. A pak spolu.</h2>
        <p class="lead">Žádný nákup naslepo. Koloběžku si nejdřív vyzkoušíš s osobním vedením – a po nákupu nejsi sám.</p>
      </div>
      <TryBuyJoin />
      <div class="btn-row" style="margin-top:32px">
        <a class="btn btn--primary" href="/proefrit-en-lessen/">Zkušební jízda & lekce <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- KDE JEZDÍME -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Kde jezdíme</span>
        <h2>Od parku v Hoofddorpu až k moři</h2>
        <p class="lead">Začínáme v klidu v parku. Když technika sedí, vyrazíme na delší trasy – třeba přes duny až na pláž v Zandvoortu.</p>
      </div>
      <RouteMap />
    </div>
  </section>

  <!-- REFERENCE -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Zkušenosti</span>
        <h2>Co říkají ti, kdo to zkusili</h2>
      </div>
      <Testimonials featuredOnly limit={3} />
      <p style="margin-top:24px"><a href="/ervaringen/">Všechny reference →</a></p>
    </div>
  </section>

  <!-- O LINDĚ -->
  <section class="section">
    <div class="container split">
      <Photo src={imgLinda} alt="Linda Pokorná se svou koloběžkou Crussis Cobra" ratio="4 / 3" />
      <div>
        <span class="eyebrow">Kdo tě povede</span>
        <h2>Ahoj, jsem Linda</h2>
        <p class="lead">Narodila jsem se v Česku, vyrostla v Holandsku. V Česku je steppen populární sport – a tak jsem svou koloběžku přivezla s sebou.</p>
        <p>Brzy jsem zjistila, že Holandsko je pro steppen jako stvořené, jen se na něj tady trochu zapomnělo. Mým cílem je dostat Holandsko na koloběžku – zábavně, zdravě a v každém věku.</p>
        <p class="motto">„I will not let age change me, I will change the way I age.“</p>
        <a class="btn btn--secondary" href="/over-linda/">Můj příběh</a>
      </div>
    </div>
  </section>

  <!-- SKUPINY A POUKAZ -->
  <section class="section section--tint" style="padding-block:clamp(40px,6vw,72px)">
    <div class="container">
      <ExtrasCards />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-wrap">
      <div class="section-head">
        <span class="eyebrow">Časté dotazy</span>
        <h2>Než vyrazíš</h2>
        <p class="lead">Nenašel/la jsi odpověď? <a href={site.whatsapp} target="_blank" rel="noopener">Napiš mi na WhatsApp</a>.</p>
        <a href="/veelgestelde-vragen/">Všechny dotazy →</a>
      </div>
      <FaqList items={faq.map((f) => f.data)} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .intro {
    padding-top: clamp(24px, 4vw, 48px);
  }
  .benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .benefit {
    background: var(--bg);
    border-radius: var(--radius-lg);
    padding: clamp(18px, 2.4vw, 26px);
    transform: rotate(var(--tilt));
    transition: transform 0.25s ease;
  }
  .benefit:hover {
    transform: rotate(0deg) scale(1.03);
  }
  .benefit h3 {
    margin: 14px 0 6px;
    font-size: 1.2rem;
  }
  .benefit p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .benefit__icon {
    width: 50px;
    height: 50px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: var(--white);
    color: var(--fg);
    box-shadow: var(--shadow-sm);
  }
  @media (max-width: 420px) {
    .benefits {
      grid-template-columns: 1fr;
    }
  }
  .head-row {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }
  .head-row > div {
    max-width: 680px;
  }
  .motto {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--forest-700);
    border-left: 4px solid var(--orange-500);
    padding-left: 16px;
    margin: 24px 0 28px;
  }
  .faq-wrap {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .faq-wrap {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }
</style>
