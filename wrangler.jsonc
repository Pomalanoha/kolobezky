// Cloudflare Workers – statický web + malý server pro e-shop.
{
  "name": "kolobezky",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "html_handling": "auto-trailing-slash"
  },
  // Databáze objednávek. database_id musí být uvedené, jinak náhledy větví (dev-…) databázi nenajdou.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kolobezky-objednavky",
      "database_id": "47b69fa1-9025-4308-9123-09641ca72561"
    }
  ],
  // Náhledy větví (dev-…) propojení nedědí – bez tohoto bloku na nich nefungují objednávky ani formuláře.
  // Náhledy zapisují do stejné databáze jako ostrý web (testovací objednávky pak smazat v administraci).
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "kolobezky-objednavky",
        "database_id": "47b69fa1-9025-4308-9123-09641ca72561"
      }
    ]
  },
  "observability": { "enabled": true }
}
